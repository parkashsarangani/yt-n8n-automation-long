{
  "schema_id": "asset_manifest",
  "version": "1.0.0",
  "status": "active",
  "description": "One image per scene. `source` records how it was obtained: a scene that fell all the way through to a placeholder is degraded, not broken, and is counted rather than hidden.",
  "produced_by": ["asset_collector"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AssetManifestArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes", "degraded_count"],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 300,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "source", "prompt"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "image_uri": {
              "type": "string",
              "pattern": "^blob://sha256:[0-9a-f]{64}$",
              "description": "Absent only when source is \"placeholder\" and no image exists."
            },
            "source": {
              "type": "string",
              "enum": ["primary", "fallback", "placeholder"],
              "description": "Which rung of the failure ladder produced this image."
            },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      },
      "degraded_count": {
        "type": "integer",
        "minimum": 0,
        "description": "Scenes that reached the placeholder rung. A quality gauge, distinct from a run failure."
      }
    }
  }
}
