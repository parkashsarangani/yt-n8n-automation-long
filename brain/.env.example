# Copy to .env (which is gitignored) and fill in what you have.
#
#   cd brain && cp .env.example .env && npm run smoke
#
# Every provider falls back to a deterministic fake when its credential is
# missing, so a partial setup still runs the whole graph end to end. The console
# prints which mode each provider is in before the run starts.

# ---------------------------------------------------------------------------
# 1. Anthropic — reasoning agents (story, script, visual plan).  REQUIRED.
#    https://console.anthropic.com  ->  API keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# 2. ElevenLabs — voiceover.  Optional; falls back to a fake.
#    Key:      https://elevenlabs.io  ->  profile menu  ->  API key
#    Voice id: Voices -> pick a voice -> ID (a 20-char string, not the name)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# 3. Fal — image generation.  Optional; falls back to a fake.
#    https://fal.ai/dashboard/keys   (format is usually "<id>:<secret>")
# ---------------------------------------------------------------------------
FAL_KEY=

# ---------------------------------------------------------------------------
# 4. long-compose — video assembly. Your own service, not a third party.
#    Start it from the repo root:  docker compose up -d --build
#    Then it is reachable on the offset host port from docker-compose.yml.
#    Optional; falls back to a fake renderer.
# ---------------------------------------------------------------------------
COMPOSE_URL=http://localhost:4001

# ---------------------------------------------------------------------------
# 5. YouTube — publishing. Optional; falls back to a dry-run target.
#
#    This is an OAuth2 ACCESS TOKEN, not an API key, and it expires in ~1 hour.
#    Acquiring/refreshing it is deliberately out of scope for the brain.
#    Quickest path for a first test:
#      - https://console.cloud.google.com -> enable "YouTube Data API v3"
#      - create an OAuth 2.0 Client ID (Desktop app)
#      - https://developers.google.com/oauthplayground -> gear icon ->
#        "Use your own OAuth credentials" -> paste client id/secret
#      - authorize scope: https://www.googleapis.com/auth/youtube.upload
#      - exchange for an access token and paste it below
#
#    A token alone will NOT upload anything. The smoke script also requires an
#    explicit --publish flag, and always uploads as PRIVATE.
# ---------------------------------------------------------------------------
YOUTUBE_ACCESS_TOKEN=

# Where artifacts, blobs and the run log are written. Default: brain/.amos-data
# AMOS_DATA=
