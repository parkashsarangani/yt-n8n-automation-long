{
  "graph_id": "skeleton",
  "version": "2",
  "description": "Walking skeleton through asset production: intent -> story -> human gate -> script -> (visual plan -> images | voice). Render and publish are added once those workers exist.",
  "nodes": [
    {
      "id": "intent",
      "type": "input",
      "schema_id": "intent"
    },
    {
      "id": "story",
      "transformation": "story_architect",
      "in": ["intent"]
    },
    {
      "id": "approve_story",
      "type": "human_gate",
      "in": ["story"],
      "policy": {
        "auto_pass_if": "confidence.overall >= 0.9"
      }
    },
    {
      "id": "script",
      "transformation": "script_writer",
      "in": ["approve_story"]
    },
    {
      "id": "visual_plan",
      "transformation": "visual_planner",
      "in": ["script"]
    },
    {
      "id": "assets",
      "transformation": "asset_collector",
      "in": ["visual_plan"]
    },
    {
      "id": "voice",
      "transformation": "voice",
      "in": ["script"]
    }
  ]
}
