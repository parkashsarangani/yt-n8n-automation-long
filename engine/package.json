{
  "name": "@vidgen/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VidGen engine — artifact store, schema registry, agent/worker runner",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.itest.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "visual:benchmark": "node --env-file-if-exists=.env --import tsx scripts/visual-benchmark.ts",
    "ui": "node --env-file-if-exists=.env --import tsx scripts/serve.ts",
    "youtube-token": "node --import tsx ../scripts/youtube-token.ts",
    "youtube-auth": "node --import tsx ../scripts/youtube-token.ts --auth"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "@types/semver": "^7.5.8",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
