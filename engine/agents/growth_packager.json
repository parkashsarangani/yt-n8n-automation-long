{
  "name": "growth_packager",
  "kind": "agent",
  "version": "6",
  "consumes": [
    {
      "schema_id": "intent",
      "range": "^2",
      "as": "intent"
    },
    {
      "schema_id": "channel_insights",
      "range": "^2",
      "as": "insights"
    }
  ],
  "produces": "growth_package",
  "produces_version": "1.2.0",
  "prompt": "growth_packager@6",
  "model": {
    "capability": "reasoning_fast",
    "max_output_tokens": 5000,
    "effort": "low"
  },
  "confidence_dimensions": [
    "clickability",
    "story_potential",
    "audience_size"
  ],
  "retry": {
    "max_attempts": 3
  }
}
