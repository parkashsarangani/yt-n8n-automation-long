{
  "name": "growth_packager",
  "kind": "agent",
  "version": "2",
  "consumes": [
    { "schema_id": "intent", "range": "^1", "as": "intent" },
    { "schema_id": "channel_insights", "range": "^2", "as": "insights" }
  ],
  "produces": "growth_package",
  "produces_version": "1.2.0",
  "prompt": "growth_packager@2",
  "model": {"capability": "reasoning_high", "max_output_tokens": 5000},
  "confidence_dimensions": ["clickability", "story_potential", "audience_size"],
  "retry": {"max_attempts": 3}
}
