{
  "name": "visual_planner",
  "kind": "agent",
  "version": "2",
  "consumes": [{ "schema_id": "script", "range": "^1", "as": "script" }],
  "produces": "visual_plan",
  "prompt": "visual_planner@2",
  "model": {
    "capability": "reasoning_fast",
    "max_output_tokens": 16000,
    "effort": "medium"
  },
  "confidence_dimensions": ["concreteness", "variety"],
  "retry": { "max_attempts": 3 }
}
