{
  "name": "discovery",
  "kind": "agent",
  "version": "5",
  "consumes": [
    {
      "schema_id": "topic_history",
      "range": "^1",
      "as": "history"
    },
    {
      "schema_id": "channel_insights",
      "range": "^2",
      "as": "insights"
    }
  ],
  "produces": "topic_candidates",
  "produces_version": "2.0.0",
  "prompt": "discovery@5",
  "model": {
    "capability": "reasoning_fast",
    "max_output_tokens": 12000,
    "effort": "low"
  },
  "confidence_dimensions": [
    "novelty",
    "evidence_strength",
    "clickability",
    "story_potential"
  ],
  "retry": {
    "max_attempts": 3
  }
}
