{
  "name": "discovery",
  "kind": "agent",
  "version": "4",
  "consumes": [
    { "schema_id": "topic_history", "range": "^1", "as": "history" },
    { "schema_id": "channel_insights", "range": "^2", "as": "insights" }
  ],
  "produces": "topic_candidates",
  "produces_version": "2.0.0",
  "prompt": "discovery@4",
  "model": {"capability": "reasoning_high", "max_output_tokens": 18000},
  "confidence_dimensions": ["novelty", "evidence_strength", "clickability", "story_potential"],
  "retry": {"max_attempts": 3}
}
