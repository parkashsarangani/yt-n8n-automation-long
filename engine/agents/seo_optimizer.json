{
  "name": "seo_optimizer",
  "kind": "agent",
  "version": "1",
  "consumes": [
    { "schema_id": "story", "range": "^1", "as": "story" },
    { "schema_id": "script", "range": "^1", "as": "script" }
  ],
  "produces": "seo_metadata",
  "prompt": "seo_optimizer@1",
  "model": {
    "capability": "reasoning_fast",
    "max_output_tokens": 4000,
    "effort": "medium"
  },
  "confidence_dimensions": ["searchability", "honesty"],
  "retry": { "max_attempts": 3 }
}
