{
  "name": "explanation_visual_planner",
  "kind": "agent",
  "version": "7",
  "consumes": [
    { "schema_id": "script", "range": "^1", "as": "script" },
    { "schema_id": "episode_visual_model", "range": "^1", "as": "visual_model" },
    { "schema_id": "cast_roster", "range": "^1", "as": "cast_roster" }
  ],
  "produces": "explanation_plan",
  "produces_version": "1.7.0",
  "prompt": "explanation_visual_planner@1",
  "model": { "capability": "reasoning_high", "max_output_tokens": 22000, "effort": "high" },
  "confidence_dimensions": ["explanatory_clarity", "state_change_coverage", "character_restraint", "scan_readability", "dialogue_visual_alignment"],
  "retry": { "max_attempts": 3 }
}
