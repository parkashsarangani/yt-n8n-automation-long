{
  "name": "dialogue_script_writer",
  "kind": "agent",
  "version": "10",
  "consumes": [
    { "schema_id": "story", "range": "^1", "as": "story" },
    { "schema_id": "cast_roster", "range": "^1", "as": "cast_roster" }
  ],
  "produces": "script",
  "prompt": "dialogue_script_writer@10",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 18000
  },
  "confidence_dimensions": ["narrative_coherence", "pacing", "hook_strength", "retention_fidelity", "cast_fidelity", "story_frame_strength", "engagement", "payoff_resolution", "visible_story_action", "central_object_usage", "viewer_value", "natural_dialogue", "relatability", "duplicate_resistance", "spatial_action"],
  "retry": { "max_attempts": 3 }
}
