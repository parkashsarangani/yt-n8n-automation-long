{
  "name": "narration_script_writer",
  "kind": "agent",
  "version": "1",
  "consumes": [
    { "schema_id": "story", "range": "^1", "as": "story" }
  ],
  "produces": "script",
  "prompt": "narration_script_writer@1",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 12000
  },
  "confidence_dimensions": ["prose_quality", "pacing", "payoff_delivery"],
  "retry": { "max_attempts": 3 }
}
