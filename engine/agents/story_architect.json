{
  "name": "story_architect",
  "kind": "agent",
  "version": "4",
  "consumes": [
    { "schema_id": "intent", "range": "^1", "as": "intent" },
    { "schema_id": "channel_insights", "range": "^1", "as": "insights" }
  ],
  "produces": "story",
  "prompt": "story_architect@4",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 5000
  },
  "confidence_dimensions": ["premise_strength", "novelty", "visual_potential"],
  "retry": { "max_attempts": 3 }
}
