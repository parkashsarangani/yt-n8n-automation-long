{
  "name": "explanation_plan_critic",
  "kind": "agent",
  "version": "1",
  "consumes": [
    {
      "schema_id": "script",
      "range": "^1",
      "as": "script"
    },
    {
      "schema_id": "explanation_plan",
      "range": "^1",
      "as": "plan"
    }
  ],
  "produces": "explanation_plan_review",
  "produces_version": "1.0.0",
  "prompt": "explanation_plan_critic@1",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 16000,
    "effort": "high"
  },
  "confidence_dimensions": [
    "evaluation_reliability",
    "evidence_coverage"
  ],
  "retry": {
    "max_attempts": 2
  }
}
