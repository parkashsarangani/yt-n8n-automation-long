{
  "name": "script_quality_critic",
  "kind": "agent",
  "version": "1",
  "consumes": [
    {
      "schema_id": "story",
      "range": "^1",
      "as": "story"
    },
    {
      "schema_id": "script",
      "range": "^1",
      "as": "script"
    },
    {
      "schema_id": "cast_roster",
      "range": "^1",
      "as": "cast_roster"
    }
  ],
  "produces": "script_quality_report",
  "prompt": "script_quality_critic@1",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 5000,
    "effort": "high"
  },
  "confidence_dimensions": [
    "evaluation_reliability",
    "evidence_coverage"
  ],
  "retry": {
    "max_attempts": 2
  }
}
