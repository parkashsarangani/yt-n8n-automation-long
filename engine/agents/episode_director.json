{
  "name": "episode_director",
  "kind": "agent",
  "version": "6",
  "consumes": [
    { "schema_id": "script", "range": "^1", "as": "script" },
    { "schema_id": "growth_package", "range": "^1", "as": "growth" }
  ],
  "produces": "episode_direction",
  "prompt": "episode_director@6",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 16000
  },
  "confidence_dimensions": ["prompt_specificity", "camera_variety", "visual_change", "hero_selection"],
  "retry": { "max_attempts": 3 }
}
