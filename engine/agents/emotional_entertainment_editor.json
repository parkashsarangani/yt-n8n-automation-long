{
  "name": "emotional_entertainment_editor",
  "kind": "agent",
  "version": "1",
  "consumes": [
    {
      "schema_id": "story",
      "range": "^1",
      "as": "story"
    },
    {
      "schema_id": "script",
      "range": "^1",
      "as": "script"
    },
    {
      "schema_id": "cast_roster",
      "range": "^1",
      "as": "cast_roster"
    }
  ],
  "produces": "script",
  "produces_version": "1.4.0",
  "prompt": "emotional_entertainment_editor@1",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 18000,
    "effort": "high"
  },
  "confidence_dimensions": [
    "emotional_momentum",
    "entertainment_value",
    "earned_surprise",
    "relationship_dynamics",
    "character_authenticity",
    "comprehension_preservation",
    "factual_fidelity"
  ],
  "retry": {
    "max_attempts": 3
  }
}
