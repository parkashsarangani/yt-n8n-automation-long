{
  "name": "script_quality_reviser",
  "kind": "agent",
  "version": "2",
  "consumes": [
    {
      "schema_id": "story",
      "range": "^1",
      "as": "story"
    },
    {
      "schema_id": "script",
      "range": "^1",
      "as": "script"
    },
    {
      "schema_id": "script_quality_report",
      "range": "^1",
      "as": "quality_report"
    },
    {
      "schema_id": "cast_roster",
      "range": "^1",
      "as": "cast_roster"
    }
  ],
  "produces": "script",
  "produces_version": "1.6.0",
  "prompt": "script_quality_reviser@2",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 24000,
    "effort": "high"
  },
  "confidence_dimensions": [
    "revision_fidelity",
    "dialogue_naturalness",
    "character_chemistry",
    "retention_improvement",
    "comprehension_preservation"
  ],
  "retry": {
    "max_attempts": 3
  }
}
