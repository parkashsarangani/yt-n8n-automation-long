  "kind": "agent",
  "version": "1",
  "consumes": [
    { "schema_id": "story", "range": "^1", "as": "story" },
    { "schema_id": "script", "range": "^1", "as": "script" },
    { "schema_id": "cast_roster", "range": "^1", "as": "cast" }
  ],
  "produces": "thumbnail_brief",
