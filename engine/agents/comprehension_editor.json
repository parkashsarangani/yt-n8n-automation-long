{
  "name": "comprehension_editor",
  "kind": "agent",
  "version": "2",
  "consumes": [
    { "schema_id": "story", "range": "^1", "as": "story" },
    { "schema_id": "script", "range": "^1", "as": "script" },
    { "schema_id": "cast_roster", "range": "^1", "as": "cast_roster" }
  ],
  "produces": "script",
  "prompt": "comprehension_editor@2",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 18000,
    "effort": "medium"
  },
  "confidence_dimensions": [
    "factual_fidelity",
    "misconception_fairness",
    "causal_clarity",
    "visual_model_explanatory_power",
    "dialogue_naturalness",
    "teach_back_success"
  ],
  "retry": { "max_attempts": 3 }
}
