{
  "name": "script_writer",
  "kind": "agent",
  "version": "2",
  "consumes": [{ "schema_id": "story", "range": "^1", "as": "story" }],
  "produces": "script",
  "prompt": "script_writer@2",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 16000
  },
  "confidence_dimensions": ["narrative_coherence", "pacing", "hook_strength", "retention_fidelity"],
  "retry": { "max_attempts": 3 }
}
