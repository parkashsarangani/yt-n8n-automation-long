{
  "name": "script_writer",
  "kind": "agent",
  "version": "1",
  "consumes": [{ "schema_id": "story", "range": "^1", "as": "story" }],
  "produces": "script",
  "prompt": "script_writer@1",
  "model": {
    "capability": "reasoning_high",
    "max_output_tokens": 16000,
    "effort": "high"
  },
  "confidence_dimensions": ["narrative_coherence", "pacing", "hook_strength"],
  "retry": { "max_attempts": 3 }
}
