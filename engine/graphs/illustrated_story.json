{
  "graph_id": "illustrated_story",
  "version": "8",
  "description": "RFC 0008 illustrated-story format plus RFC 0009 growth optimization and production hardening. A deterministic package-release boundary canonicalizes and validates title/thumbnail family membership before story, script, thumbnail, or asset spend. Creative viability and watchability release then happen before scene-image spend. Pre-TTS moderation produces an immutable audit record and must approve the exact script before voice synthesis. Directed 1-3 shot scenes use hero budgeting and sequence review, then a visual-asset release blocks deterministically bad fallback/continuity/hero results before expensive rendering. Final technical QA remains defense-in-depth before publish.",
  "nodes": [
    { "id": "intent", "type": "input", "schema_id": "intent" },
    { "id": "performance", "type": "input", "schema_id": "performance_window" },
    { "id": "insights", "transformation": "channel_strategist", "in": ["performance"] },
    { "id": "package", "transformation": "growth_packager", "in": ["intent", "insights"] },
    { "id": "package_release", "transformation": "growth_package_release", "in": ["package"] },
    { "id": "story", "transformation": "narrative_story_architect", "in": ["intent", "insights", "package_release"] },
    { "id": "approve_story", "type": "human_gate", "in": ["story"], "policy": { "auto_pass_if": "always" } },
    { "id": "draft_script", "transformation": "narration_script_writer", "in": ["approve_story", "package_release"] },
    { "id": "watchability_report", "transformation": "watchability_critic", "in": ["approve_story", "draft_script", "package_release"] },
    { "id": "creative_viability", "type": "human_gate", "in": ["watchability_report"], "policy": { "auto_pass_if": "payload.abandon_recommended == false" } },
    { "id": "watchability_release", "transformation": "watchability_release", "in": ["draft_script", "creative_viability", "package_release"] },
    { "id": "approve_script", "type": "human_gate", "in": ["watchability_release"], "policy": { "auto_pass_if": "always" } },
    { "id": "direction", "transformation": "episode_director", "in": ["approve_script", "package_release"] },
    { "id": "assets", "transformation": "illustrated_scene_assets", "in": ["direction", "approve_script", "intent"] },
    { "id": "visual_asset_release", "transformation": "visual_asset_release", "in": ["assets"] },
    { "id": "tts_moderation", "transformation": "tts_moderation", "in": ["approve_script"] },
    { "id": "voice", "transformation": "voice", "in": ["approve_script", "tts_moderation"] },
    { "id": "seo", "transformation": "seo_optimizer", "in": ["approve_story", "approve_script", "package_release"] },
    { "id": "thumbnail_brief", "transformation": "thumbnail_designer", "in": ["approve_story", "package_release"] },
    { "id": "thumbnail", "transformation": "thumbnail", "in": ["thumbnail_brief"] },
    { "id": "render", "transformation": "render", "in": ["approve_script", "voice", "assets", "package_release", "visual_asset_release"] },
    { "id": "qa", "transformation": "qa", "in": ["intent", "approve_script", "assets", "voice", "render", "thumbnail", "seo"] },
    { "id": "approve_publish", "type": "human_gate", "in": ["qa"], "policy": { "auto_pass_if": "payload.verdict == \"pass\"" } },
    { "id": "publish", "transformation": "publish", "in": ["render", "seo", "thumbnail", "approve_publish"] }
  ]
}
