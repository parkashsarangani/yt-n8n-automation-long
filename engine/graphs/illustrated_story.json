{
  "graph_id": "illustrated_story",
  "version": "2",
  "description": "RFC 0008 illustrated-story format plus RFC 0009 growth optimization. Every run establishes a pre-script growth package (title/thumbnail/opening promise), gates the finished script against that promise and first 30 seconds, directs 1-3 visual shots per narration beat with hero-shot budgeting, generates/reviews illustrated shot packs, then runs technical QA before publish.",
  "nodes": [
    { "id": "intent", "type": "input", "schema_id": "intent" },
    { "id": "performance", "type": "input", "schema_id": "performance_window" },
    { "id": "insights", "transformation": "channel_strategist", "in": ["performance"] },
    { "id": "package", "transformation": "growth_packager", "in": ["intent", "insights"] },
    { "id": "story", "transformation": "narrative_story_architect", "in": ["intent", "insights", "package"] },
    { "id": "approve_story", "type": "human_gate", "in": ["story"], "policy": { "auto_pass_if": "always" } },
    { "id": "draft_script", "transformation": "narration_script_writer", "in": ["approve_story", "package"] },
    { "id": "watchability_report", "transformation": "watchability_critic", "in": ["approve_story", "draft_script", "package"] },
    { "id": "watchability_release", "transformation": "watchability_release", "in": ["draft_script", "watchability_report"] },
    { "id": "approve_script", "type": "human_gate", "in": ["watchability_release"], "policy": { "auto_pass_if": "always" } },
    { "id": "direction", "transformation": "episode_director", "in": ["approve_script", "package"] },
    { "id": "assets", "transformation": "illustrated_scene_assets", "in": ["direction", "approve_script", "intent"] },
    { "id": "voice", "transformation": "voice", "in": ["approve_script"] },
    { "id": "seo", "transformation": "seo_optimizer", "in": ["approve_story", "approve_script", "package"] },
    { "id": "thumbnail_brief", "transformation": "thumbnail_designer", "in": ["approve_story", "package"] },
    { "id": "thumbnail", "transformation": "thumbnail", "in": ["thumbnail_brief"] },
    { "id": "render", "transformation": "render", "in": ["approve_script", "voice", "assets"] },
    { "id": "qa", "transformation": "qa", "in": ["intent", "approve_script", "assets", "voice", "render", "thumbnail", "seo"] },
    { "id": "approve_publish", "type": "human_gate", "in": ["qa"], "policy": { "auto_pass_if": "payload.verdict == \"pass\"" } },
    { "id": "publish", "transformation": "publish", "in": ["render", "seo", "thumbnail", "approve_publish"] }
  ]
}
