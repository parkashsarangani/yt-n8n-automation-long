{
  "graph_id": "visual_benchmark",
  "version": "1.0.0",
  "description": "RFC 0010 isolated end-to-end benchmark. Reuses an approved script, its existing voice artifact, and the current production render as a blind control; resolves a 90-120s visual window, renders V2, judges final pixels, and emits the kill-gate report. It never publishes or replaces production.",
  "nodes": [
    { "id": "script", "type": "input", "schema_id": "script" },
    { "id": "voice", "type": "input", "schema_id": "voice" },
    { "id": "control_render", "type": "input", "schema_id": "rendered_video" },
    {
      "id": "visual_direction",
      "transformation": "visual_director",
      "in": ["script", "voice"]
    },
    {
      "id": "visual_assets",
      "transformation": "visual_beat_assets",
      "in": ["visual_direction", "voice"]
    },
    {
      "id": "visual_timeline",
      "transformation": "visual_timeline",
      "in": ["visual_direction", "visual_assets", "voice"]
    },
    {
      "id": "candidate_render",
      "transformation": "visual_benchmark_render",
      "in": ["visual_timeline"]
    },
    {
      "id": "benchmark_report",
      "transformation": "visual_benchmark_qa",
      "in": ["visual_direction", "visual_timeline", "control_render", "candidate_render"]
    }
  ]
}
