{
  "graph_id": "skeleton",
  "version": "9",
  "description": "Walking skeleton, end to end, running unattended. Both gates auto-pass: the finished video is uploaded PRIVATE and that upload is the review — a gate that parks the run would leave nothing to review at all, which is worse than a weak draft you can watch and delete. Set either gate's policy back to a threshold, or remove it, to put a human back in the loop. Nothing becomes public without one.",
  "nodes": [
    {
      "id": "intent",
      "type": "input",
      "schema_id": "intent"
    },
    {
      "id": "performance",
      "type": "input",
      "schema_id": "performance_window"
    },
    {
      "id": "insights",
      "transformation": "channel_strategist",
      "in": [
        "performance"
      ]
    },
    {
      "id": "story",
      "transformation": "story_architect",
      "in": [
        "intent",
        "insights"
      ]
    },
    {
      "id": "approve_story",
      "type": "human_gate",
      "in": [
        "story"
      ],
      "policy": {
        "auto_pass_if": "always"
      }
    },
    {
      "id": "script",
      "transformation": "script_writer",
      "in": [
        "approve_story"
      ]
    },
    {
      "id": "approve_script",
      "type": "human_gate",
      "in": [
        "script"
      ],
      "policy": {
        "auto_pass_if": "always"
      }
    },
    {
      "id": "visual_plan",
      "transformation": "visual_planner",
      "in": [
        "approve_script"
      ]
    },
    {
      "id": "assets",
      "transformation": "asset_collector",
      "in": [
        "visual_plan"
      ]
    },
    {
      "id": "voice",
      "transformation": "voice",
      "in": [
        "approve_script"
      ]
    },
    {
      "id": "seo",
      "transformation": "seo_optimizer",
