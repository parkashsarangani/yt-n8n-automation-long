{
  "graph_id": "skeleton",
  "version": "8",
  "description": "Walking skeleton, end to end, with the feedback loop closed. Every run begins by reading what past episodes actually did: the service seeds a performance_window, the strategist turns it into guidance, and the story architect writes against that evidence. Two human gates: the story premise and the narration script. The thumbnail branch hangs off the approved story and the SEO branch off the approved script, so both run while the video renders.",
  "nodes": [
    {
      "id": "intent",
      "type": "input",
      "schema_id": "intent"
    },
    {
      "id": "performance",
      "type": "input",
      "schema_id": "performance_window"
    },
    {
      "id": "insights",
      "transformation": "channel_strategist",
      "in": [
        "performance"
      ]
    },
    {
      "id": "story",
      "transformation": "story_architect",
      "in": [
        "intent",
        "insights"
      ]
    },
    {
      "id": "approve_story",
      "type": "human_gate",
      "in": [
        "story"
      ],
      "policy": {
        "auto_pass_if": "confidence.overall >= 0.9"
      }
    },
    {
      "id": "script",
      "transformation": "script_writer",
      "in": [
        "approve_story"
      ]
    },
    {
      "id": "approve_script",
      "type": "human_gate",
      "in": [
        "script"
      ]
    },
    {
      "id": "visual_plan",
      "transformation": "visual_planner",
      "in": [
        "approve_script"
      ]
    },
    {
      "id": "assets",
      "transformation": "asset_collector",
      "in": [
        "visual_plan"
      ]
    },
    {
      "id": "voice",
      "transformation": "voice",
      "in": [
        "approve_script"
      ]
    },
    {
      "id": "seo",
      "transformation": "seo_optimizer",
      "in": [
        "approve_story",
        "approve_script"
      ]
    },
    {
      "id": "thumbnail_brief",
      "transformation": "thumbnail_designer",
      "in": [
        "approve_story"
      ]
    },
    {
      "id": "thumbnail",
      "transformation": "thumbnail",
      "in": [
        "thumbnail_brief"
      ]
    },
    {
      "id": "render",
      "transformation": "render",
      "in": [
        "script",
        "voice",
        "assets"
      ]
    },
    {
      "id": "publish",
      "transformation": "publish",
      "in": [
        "render",
        "seo",
        "thumbnail"
      ]
    }
  ]
}
