{
  "graph_id": "cartoon",
  "version": "5",
  "description": "Primary two-character cartoon explainer graph. An approved comprehension story becomes a dialogue draft, then an independent comprehension editor repairs factual fidelity, misconception fairness, causal clarity, the central visual model, and the final teach-back before any voice, visual planning, rendering, or publishing cost is incurred. The existing recurring cast, SVG-puppet renderer, creative direction, per-character voices, thumbnail system, deterministic QA, and stock-mode isolation remain intact.",
  "nodes": [
    {
      "id": "intent",
      "type": "input",
      "schema_id": "intent"
    },
    {
      "id": "performance",
      "type": "input",
      "schema_id": "performance_window"
    },
    {
      "id": "cast_roster",
      "type": "input",
      "schema_id": "cast_roster"
    },
    {
      "id": "insights",
      "transformation": "channel_strategist",
      "in": [
        "performance"
      ]
    },
    {
      "id": "story",
      "transformation": "story_architect",
      "in": [
        "intent",
        "insights"
      ]
    },
    {
      "id": "approve_story",
      "type": "human_gate",
      "in": [
        "story"
      ],
      "policy": {
        "auto_pass_if": "always"
      }
    },
    {
      "id": "draft_script",
      "transformation": "dialogue_script_writer",
      "in": [
        "approve_story",
        "cast_roster"
      ]
    },
    {
      "id": "comprehension_edit",
      "transformation": "comprehension_editor",
      "in": [
        "approve_story",
        "draft_script",
        "cast_roster"
      ]
    },
    {
      "id": "approve_script",
      "type": "human_gate",
      "in": [
        "comprehension_edit"
      ],
      "policy": {
        "auto_pass_if": "confidence.overall >= 0.86"
      }
    },
    {
      "id": "creative_direction",
      "transformation": "cartoon_creative_director",
      "in": [
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "visual_plan",
      "transformation": "cartoon_visual_planner",
      "in": [
        "approve_script",
        "cast_roster",
        "creative_direction"
      ]
    },
    {
      "id": "assets",
      "transformation": "cartoon_scene_compiler",
      "in": [
        "visual_plan",
        "approve_script",
        "cast_roster",
        "creative_direction"
      ]
    },
    {
      "id": "voice",
      "transformation": "dialogue_voice",
      "in": [
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "seo",
      "transformation": "seo_optimizer",
      "in": [
        "approve_story",
        "approve_script"
      ]
    },
    {
      "id": "thumbnail_brief",
      "transformation": "cartoon_thumbnail_designer",
      "in": [
        "approve_story",
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "thumbnail",
      "transformation": "thumbnail",
      "in": [
        "thumbnail_brief"
      ]
    },
    {
      "id": "render",
      "transformation": "cartoon_render",
      "in": [
        "approve_script",
        "voice",
        "assets",
        "cast_roster"
      ]
    },
    {
      "id": "qa",
      "transformation": "qa",
      "in": [
        "intent",
        "approve_script",
        "assets",
        "voice",
        "render",
        "thumbnail",
        "seo"
      ]
    },
    {
      "id": "approve_publish",
      "type": "human_gate",
      "in": [
        "qa"
      ],
      "policy": {
        "auto_pass_if": "payload.verdict == \"pass\""
      }
    },
    {
      "id": "publish",
      "transformation": "publish",
      "in": [
        "render",
        "seo",
        "thumbnail",
        "approve_publish"
      ]
    }
  ]
}
