{
  "graph_id": "cartoon",
  "version": "6",
  "description": "Two-character comprehension pipeline with character-aware retention editing, adversarial script criticism, a targeted revision pass, and deterministic per-dimension release thresholds before any voice or rendering cost.",
  "nodes": [
    {
      "id": "intent",
      "type": "input",
      "schema_id": "intent"
    },
    {
      "id": "performance",
      "type": "input",
      "schema_id": "performance_window"
    },
    {
      "id": "cast_roster",
      "type": "input",
      "schema_id": "cast_roster"
    },
    {
      "id": "insights",
      "transformation": "channel_strategist",
      "in": [
        "performance"
      ]
    },
    {
      "id": "story",
      "transformation": "story_architect",
      "in": [
        "intent",
        "insights"
      ]
    },
    {
      "id": "approve_story",
      "type": "human_gate",
      "in": [
        "story"
      ],
      "policy": {
        "auto_pass_if": "always"
      }
    },
    {
      "id": "draft_script",
      "transformation": "dialogue_script_writer",
      "in": [
        "approve_story",
        "cast_roster"
      ]
    },
    {
      "id": "comprehension_edit",
      "transformation": "comprehension_editor",
      "in": [
        "approve_story",
        "draft_script",
        "cast_roster"
      ]
    },
    {
      "id": "retention_edit",
      "transformation": "retention_character_editor",
      "in": [
        "approve_story",
        "comprehension_edit",
        "cast_roster"
      ]
    },
    {
      "id": "quality_draft",
      "transformation": "script_quality_critic",
      "in": [
        "approve_story",
        "retention_edit",
        "cast_roster"
      ]
    },
    {
      "id": "quality_revision",
      "transformation": "script_quality_reviser",
      "in": [
        "approve_story",
        "retention_edit",
        "quality_draft",
        "cast_roster"
      ]
    },
    {
      "id": "quality_final",
      "transformation": "script_quality_critic",
      "in": [
        "approve_story",
        "quality_revision",
        "cast_roster"
      ]
    },
    {
      "id": "quality_release",
      "transformation": "script_quality_release",
      "in": [
        "quality_revision",
        "quality_final"
      ]
    },
    {
      "id": "approve_script",
      "type": "human_gate",
      "in": [
        "quality_release"
      ],
      "policy": {
        "auto_pass_if": "always"
      }
    },
    {
      "id": "creative_direction",
      "transformation": "cartoon_creative_director",
      "in": [
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "visual_plan",
      "transformation": "cartoon_visual_planner",
      "in": [
        "approve_script",
        "cast_roster",
        "creative_direction"
      ]
    },
    {
      "id": "assets",
      "transformation": "cartoon_scene_compiler",
      "in": [
        "visual_plan",
        "approve_script",
        "cast_roster",
        "creative_direction"
      ]
    },
    {
      "id": "voice",
      "transformation": "dialogue_voice",
      "in": [
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "seo",
      "transformation": "seo_optimizer",
      "in": [
        "approve_story",
        "approve_script"
      ]
    },
    {
      "id": "thumbnail_brief",
      "transformation": "cartoon_thumbnail_designer",
      "in": [
        "approve_story",
        "approve_script",
        "cast_roster"
      ]
    },
    {
      "id": "thumbnail",
      "transformation": "thumbnail",
      "in": [
        "thumbnail_brief"
      ]
    },
    {
      "id": "render",
      "transformation": "cartoon_render",
      "in": [
        "approve_script",
        "voice",
        "assets",
        "cast_roster"
      ]
    },
    {
      "id": "qa",
      "transformation": "qa",
      "in": [
        "intent",
        "approve_script",
        "assets",
        "voice",
        "render",
        "thumbnail",
        "seo"
      ]
    },
    {
      "id": "approve_publish",
      "type": "human_gate",
      "in": [
        "qa"
      ],
      "policy": {
        "auto_pass_if": "payload.verdict == \"pass\""
      }
    },
    {
      "id": "publish",
      "transformation": "publish",
      "in": [
        "render",
        "seo",
        "thumbnail",
        "approve_publish"
      ]
    }
  ]
}
