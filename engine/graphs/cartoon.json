{
  "graph_id": "cartoon",
  "version": "12",
  "description": "Watchability-first hybrid explainer pipeline: deterministic motion graphics remain the explanatory backbone while voice-aligned, continuity-aware AI scene packs create timed visual resets; opening/payoff are full-canvas, QA measures every modality, and publishing remains private by default. The visual plan passes a storyboard review before anything renders: a critic judges every scene, a reviser rewrites the ones it flagged, and a deterministic release gate rejects a revision that left a flagged scene untouched.",
  "nodes": [
    { "id": "intent", "type": "input", "schema_id": "intent" },
    { "id": "performance", "type": "input", "schema_id": "performance_window" },
    { "id": "cast_roster", "type": "input", "schema_id": "cast_roster" },
    { "id": "insights", "transformation": "channel_strategist", "in": ["performance"] },
    { "id": "story", "transformation": "story_architect", "in": ["intent", "insights"] },
    { "id": "approve_story", "type": "human_gate", "in": ["story"], "policy": { "auto_pass_if": "always" } },
    { "id": "draft_script", "transformation": "dialogue_script_writer", "in": ["approve_story", "cast_roster"] },
    { "id": "entertainment_edit", "transformation": "emotional_entertainment_editor", "in": ["approve_story", "draft_script", "cast_roster"] },
    { "id": "quality_draft", "transformation": "script_quality_critic", "in": ["approve_story", "entertainment_edit", "cast_roster"] },
    { "id": "quality_revision", "transformation": "script_quality_reviser", "in": ["approve_story", "entertainment_edit", "quality_draft", "cast_roster"] },
    { "id": "quality_final", "transformation": "script_quality_critic", "in": ["approve_story", "quality_revision", "cast_roster"] },
    { "id": "quality_release", "transformation": "script_quality_release", "in": ["quality_revision", "quality_final"] },
    { "id": "approve_script", "type": "human_gate", "in": ["quality_release"], "policy": { "auto_pass_if": "always" } },
    { "id": "visual_plan", "transformation": "explanation_visual_planner", "in": ["approve_script", "cast_roster"] },
    { "id": "plan_review", "transformation": "explanation_plan_critic", "in": ["approve_script", "visual_plan"] },
    { "id": "plan_revision", "transformation": "explanation_plan_reviser", "in": ["approve_script", "visual_plan", "plan_review", "cast_roster"] },
    { "id": "plan_release", "transformation": "explanation_plan_release", "in": ["visual_plan", "plan_revision", "plan_review"] },
    { "id": "compiled_assets", "transformation": "cartoon_scene_compiler", "in": ["plan_release", "approve_script", "cast_roster"] },
    { "id": "voice", "transformation": "dialogue_voice", "in": ["approve_script", "cast_roster"] },
    { "id": "assets", "transformation": "hybrid_visual_assets", "in": ["compiled_assets", "plan_release", "approve_script", "cast_roster", "voice"] },
    { "id": "seo", "transformation": "seo_optimizer", "in": ["approve_story", "approve_script"] },
    { "id": "thumbnail_brief", "transformation": "cartoon_thumbnail_designer", "in": ["approve_story", "approve_script", "cast_roster"] },
    { "id": "thumbnail", "transformation": "thumbnail", "in": ["thumbnail_brief"] },
    { "id": "render", "transformation": "cartoon_render", "in": ["approve_script", "voice", "assets", "cast_roster"] },
    { "id": "qa", "transformation": "retention_qa", "in": ["intent", "approve_script", "quality_final", "assets", "voice", "render", "thumbnail", "seo"] },
    { "id": "approve_publish", "type": "human_gate", "in": ["qa"], "policy": { "auto_pass_if": "always" } },
    { "id": "publish", "transformation": "publish", "in": ["render", "seo", "thumbnail", "approve_publish"] }
  ]
}
