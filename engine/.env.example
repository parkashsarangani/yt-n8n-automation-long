# Copy to .env and fill in what you use.

# Shared FreeLLMAPI.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODEL=auto:smart
FREELLMAPI_VISION_MODEL=auto:smart

# Experimental media routing. Media model ids belong to FreeLLMAPI's separate
# registry, so auto is the portable default. Fal/ElevenLabs remain rollback.
IMAGE_PROVIDER_MODE=freellmapi
SPEECH_PROVIDER_MODE=freellmapi
FREELLMAPI_IMAGE_MODEL=auto
FREELLMAPI_SPEECH_MODEL=auto
FREELLMAPI_SPEECH_VOICE=onyx
# Preferred response format. The provider may return a different real type
# (Google/Gemini currently returns WAV), which the engine persists correctly.
FREELLMAPI_SPEECH_FORMAT=mp3
FREELLMAPI_MEDIA_TIMEOUT_MS=120000

# Paid OpenAI fallback/direct rollback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Config-only rollback providers.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FAL_KEY=

# Daily production / measurement.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_HOUR_UTC=19
SCHEDULE_MEASURE_HOURS=24

# long-compose renderer.
COMPOSE_URL=http://localhost:4001

# YouTube publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Legacy stock credentials retained only for old/manual workflows.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Where artifacts, blobs and run logs are written. Default: engine/.vidgen-data
# AMOS_DATA=
