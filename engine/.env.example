# Copy to .env and fill in what you use.

# Required reasoning for story, dialogue, cartoon direction and packaging.
# There is no offline fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Character voices. The recurring cast itself stores per-character voice ids.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Generated cartoon thumbnail artwork. Cartoon video scenes use local SVG rigs
# and backgrounds; Fal is not called once per video scene.
FAL_KEY=

# Stable recurring cast for default/scheduled production.
# Leave this at the canonical tracked cast unless intentionally overriding it.
CARTOON_CAST_PATH=/app/config/cast_roster.default.json

# Daily production cadence, ON by default (24 = daily) -- a scheduled run
# drives itself unattended all the way to a public publish. Set to 0 to
# disable scheduled production and keep episodes to manual UI starts only.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_MEASURE_HOURS=24

# long-compose renderer.
COMPOSE_URL=http://localhost:4001

# YouTube publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Legacy stock credentials retained only for old/manual workflows. The default
# cartoon production graph does not use them.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Where artifacts, blobs and run logs are written. Default: engine/.vidgen-data
# AMOS_DATA=
