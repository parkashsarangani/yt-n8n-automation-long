# Copy to .env and fill in what you use.

# Shared FreeLLMAPI. All text/reasoning runs on an ordered chain of concrete
# FREE model ids. Leave FREELLMAPI_TEXT_MODELS empty for the engine default
# chain, or set a comma list of concrete ids (no auto / auto:*).
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODELS=
LLM_ROUTER_MODE=
LLM_ROUTER_TIMEOUT_MS=

# Paid OpenAI fallback / direct rollback, plus pre-TTS moderation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
PAID_TEXT_FALLBACK=

# Narration.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Thumbnail artwork — the only image the audio-first graph generates.
FAL_KEY=
FAL_MODEL=fal-ai/flux-2
FAL_PRICE_PER_IMAGE=

# Daily production / measurement.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_HOUR_UTC=19
SCHEDULE_MEASURE_HOURS=24
MEASURE_EXCLUDE_IDS=

# long-compose renderer.
COMPOSE_URL=http://localhost:4001

# YouTube publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Where artifacts, blobs and run logs are written. Default: engine/.vidgen-data
# AMOS_DATA=

# The editor currently publishes straight to YouTube and never returns a
# final.mp4 to Drive, so the engine no longer polls for one by default (a run
# waiting at editor_review is the pipeline's normal finish line, not a stuck
# state). Set to true/1 to resume polling if that return workflow comes back —
# checkEditorReturns()/finalize_video/qa/publish are unchanged and ready.
EDITOR_RETURN_WATCH_ENABLED=
# Shared secret for POST /api/editor-returns/check, the single off-box route.
# Unset disables the route entirely (404). Set it to let an n8n Drive trigger
# pick up a returned cut immediately instead of waiting for the next poll.
EDITOR_RETURN_WEBHOOK_TOKEN=

# Operator alerting — fires when driveUnattended() gives up on a blocked run
# instead of retrying forever. Both are opt-in; leave unset to disable.
# Webhook: any Slack incoming-webhook URL, or an n8n webhook node.
OPERATOR_ALERT_WEBHOOK_URL=
# Email: sent via the Resend API (https://resend.com). Needs a Resend API key
# and a sender address on a domain verified with Resend.
RESEND_API_KEY=
OPERATOR_ALERT_EMAIL_TO=
OPERATOR_ALERT_EMAIL_FROM=
