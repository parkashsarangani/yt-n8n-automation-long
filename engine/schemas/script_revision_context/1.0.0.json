{
  "schema_id": "script_revision_context",
  "version": "1.0.0",
  "status": "active",
  "description": "Immutable lineage for a critic-guided narration rewrite. Created only after a prior script has been evaluated; the first draft has no revision context.",
  "produced_by": ["script_revision_controller"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["attempt", "mode", "previous_script", "critic", "release_failures", "directives"],
    "properties": {
      "attempt": { "type": "integer", "minimum": 2, "maximum": 6 },
      "mode": { "type": "string", "enum": ["targeted_revision", "structural_rebuild"] },
      "previous_script": { "type": "object" },
      "critic": {
        "type": "object",
        "additionalProperties": true,
        "required": ["scores", "summary"],
        "properties": {
          "scores": { "type": "object" },
          "summary": { "type": "string" },
          "weakest_dimension": { "type": ["string", "null"] },
          "verdict": { "type": ["string", "null"] },
          "abandon_recommended": { "type": "boolean" }
        }
      },
      "release_failures": {
        "type": "array",
        "maxItems": 12,
        "items": { "type": "string", "maxLength": 240 }
      },
      "directives": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
