{
  "schema_id": "episode_performance",
  "version": "1.1.0",
  "status": "active",
  "description": "RFC 0009 adds negotiated audience-retention data from YouTube's elapsedVideoTimeRatio/audienceWatchRatio report. The curve and 5/15/30-second samples are nullable/unavailable rather than fabricated when the platform rejects or lacks the report.",
  "produced_by": ["measure"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EpisodePerformanceArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["external_id", "window", "measured_at", "metrics", "source"],
    "properties": {
      "external_id": {"type": "string", "minLength": 1, "maxLength": 64},
      "url": {"type": "string", "maxLength": 300},
      "source": {"type": "string", "minLength": 1, "maxLength": 64},
      "window": {
        "type": "object", "additionalProperties": false,
        "required": ["start_date", "end_date", "days"],
        "properties": {
          "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "days": {"type": "integer", "minimum": 1, "maximum": 3650}
        }
      },
      "measured_at": {"type": "string", "format": "date-time"},
      "metrics": {
        "type": "object", "additionalProperties": false,
        "required": ["views", "estimated_minutes_watched", "average_view_duration_sec", "subscribers_gained", "likes", "comments", "shares", "retention_curve", "retention_5s", "retention_15s", "retention_30s"],
        "properties": {
          "views": {"type": "integer", "minimum": 0},
          "estimated_minutes_watched": {"type": "number", "minimum": 0},
          "average_view_duration_sec": {"type": "number", "minimum": 0},
          "average_view_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "subscribers_gained": {"type": "integer"},
          "likes": {"type": "integer", "minimum": 0},
          "comments": {"type": "integer", "minimum": 0},
          "shares": {"type": "integer", "minimum": 0},
          "impressions": {"type": ["integer", "null"], "minimum": 0},
          "click_through_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "retention_curve": {
            "type": ["array", "null"],
            "maxItems": 200,
            "description": "YouTube audienceWatchRatio samples keyed by elapsedVideoTimeRatio. Values can exceed 1 when viewers rewatch a segment.",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["elapsed_ratio", "audience_watch_ratio"],
              "properties": {
                "elapsed_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                "audience_watch_ratio": {"type": "number", "minimum": 0}
              }
            }
          },
          "retention_5s": {"type": ["number", "null"], "minimum": 0},
          "retention_15s": {"type": ["number", "null"], "minimum": 0},
          "retention_30s": {"type": ["number", "null"], "minimum": 0},
          "unavailable": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 240}}
        }
      }
    }
  }
}
