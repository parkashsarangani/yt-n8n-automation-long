{
  "schema_id": "episode_performance",
  "version": "1.0.0",
  "status": "active",
  "description": "Measured performance of a published episode over a window. An observation, not a judgement — what the numbers were, plus which numbers the platform declined to give. Immutable like every artifact: measuring the same episode over a longer window produces a NEW artifact rather than mutating this one, so the history of how a video aged is preserved instead of overwritten.",
  "produced_by": [
    "measure"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EpisodePerformanceArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "external_id",
      "window",
      "measured_at",
      "metrics",
      "source"
    ],
    "properties": {
      "external_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "url": {
        "type": "string",
        "maxLength": 300
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "window": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_date",
          "end_date",
          "days"
        ],
        "properties": {
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          }
        }
      },
      "measured_at": {
        "type": "string",
        "format": "date-time"
      },
      "metrics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "views",
          "estimated_minutes_watched",
          "average_view_duration_sec",
          "subscribers_gained",
          "likes",
          "comments",
          "shares"
        ],
        "properties": {
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "estimated_minutes_watched": {
            "type": "number",
            "minimum": 0
          },
          "average_view_duration_sec": {
            "type": "number",
            "minimum": 0
          },
          "average_view_percentage": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Retention. The best proxy for whether the video delivered on its title, and the metric to trust when click-through is unavailable."
          },
          "subscribers_gained": {
            "type": "integer"
          },
          "likes": {
            "type": "integer",
            "minimum": 0
          },
          "comments": {
            "type": "integer",
            "minimum": 0
          },
          "shares": {
            "type": "integer",
            "minimum": 0
          },
          "impressions": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "click_through_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "A FRACTION, not a percentage — the provider normalises, so 0.058 means 5.8%. null means the platform did not expose it, which is different from zero."
          },
          "unavailable": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Metrics requested and not returned. Recorded so a null reads as 'not offered' rather than 'not measured'."
          }
        }
      }
    }
  }
}
