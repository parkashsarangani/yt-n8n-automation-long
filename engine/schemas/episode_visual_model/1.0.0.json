{
  "schema_id": "episode_visual_model",
  "version": "1.0.0",
  "status": "active",
  "description": "Episode-level visual ontology with stable entity ids and reusable depiction specifications.",
  "produced_by": ["episode_visual_modeler"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EpisodeVisualModelArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["style_id", "entities"],
    "properties": {
      "style_id": { "type": "string", "const": "semantic-navy-editorial-v1" },
      "entities": {
        "type": "array", "minItems": 1, "maxItems": 64,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["entity_id", "label", "aliases", "depiction"],
          "properties": {
            "entity_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "label": { "type": "string", "minLength": 1, "maxLength": 48 },
            "aliases": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 48 } },
            "depiction": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "appearance", "color"],
              "properties": {
                "kind": { "type": "string", "enum": ["fluid", "solid-object", "particle", "molecule", "lattice", "layered-region", "flow-field", "quantity-set", "location", "abstract-subject"] },
                "appearance": { "type": "string", "minLength": 1, "maxLength": 80 },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "shape": { "type": "string", "maxLength": 40 },
                "material": { "type": "string", "maxLength": 40 },
                "formula": { "type": "string", "maxLength": 24 },
                "geometry": { "type": "string", "maxLength": 48 }
              }
            }
          }
        }
      }
    }
  }
}
