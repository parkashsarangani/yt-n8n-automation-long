{
  "schema_id": "visual_plan",
  "version": "1.1.0",
  "status": "active",
  "description": "Per-scene visual concepts. Scenes can use AI-generated images (search_terms) or motion graphics templates (template_category). Both are valid; a mix within one video is expected and encouraged.",
  "produced_by": [
    "visual_planner",
    "script_writer"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VisualPlanArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "scenes"
    ],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_index",
            "search_terms",
            "visual_style",
            "fallback_terms"
          ],
          "properties": {
            "scene_index": {
              "type": "integer",
              "minimum": 0
            },
            "search_terms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "description": "Concrete photographable subjects for AI image generation."
            },
            "visual_style": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120
            },
            "fallback_terms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "template_category": {
              "type": "string",
              "enum": [
                "timeline",
                "ranking",
                "chart",
                "counter",
                "reveal",
                "data",
                "list",
                "text",
                "roller",
                "cinematic"
              ],
              "description": "If set, this scene uses a motion graphics template instead of (or overlaid on) the AI image."
            },
            "template_data": {
              "type": "string",
              "description": "JSON-encoded props for the template. Examples: {\"events\":[{\"year\":\"1947\",\"title\":\"Independence\"}]} for timeline, {\"items\":[{\"name\":\"China\",\"value\":\"1.4B\"}],\"title\":\"Top\"} for ranking, {\"from\":0,\"to\":4300,\"unit\":\"km\",\"label\":\"LENGTH\"} for counter."
            }
          }
        }
      },
      "house_style": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}