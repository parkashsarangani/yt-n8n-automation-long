{
  "schema_id": "performance_window",
  "version": "2.1.0",
  "status": "active",
  "description": "RFC 0009 decision 9 additive feedback contract. Keeps v2 early-retention fields and adds optional creative lineage, impressions/watch-time/share metrics, retention events, and median AVD so measured outcomes can be attributed to the package/story decisions that produced them. Backward-compatible with 2.0.0 consumers.",
  "produced_by": ["human"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PerformanceWindowArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["episode_count", "episodes", "generated_at", "ctr_available", "retention_available", "aggregates"],
    "properties": {
      "generated_at": {"type": "string", "format": "date-time"},
      "episode_count": {"type": "integer", "minimum": 0},
      "ctr_available": {"type": "boolean"},
      "retention_available": {"type": "boolean"},
      "aggregates": {
        "type": "object",
        "additionalProperties": false,
        "required": ["median_views", "median_view_percentage", "median_ctr", "median_retention_5s", "median_retention_15s", "median_retention_30s", "total_subscribers_gained"],
        "properties": {
          "median_views": {"type": "number", "minimum": 0},
          "median_view_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "median_average_view_duration_sec": {"type": ["number", "null"], "minimum": 0},
          "median_ctr": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "median_retention_5s": {"type": ["number", "null"], "minimum": 0},
          "median_retention_15s": {"type": ["number", "null"], "minimum": 0},
          "median_retention_30s": {"type": ["number", "null"], "minimum": 0},
          "total_subscribers_gained": {"type": "integer"}
        }
      },
      "episodes": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external_id", "metrics"],
          "properties": {
            "external_id": {"type": "string", "maxLength": 64},
            "title": {"type": "string", "maxLength": 200},
            "primary_keyword": {"type": "string", "maxLength": 80},
            "thumbnail_text": {"type": "string", "maxLength": 60},
            "published_at": {"type": "string", "maxLength": 40},
            "window_days": {"type": "integer", "minimum": 1},
            "creative": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "package_artifact_id": {"type": "string", "maxLength": 80},
                "story_artifact_id": {"type": "string", "maxLength": 80},
                "premise": {"type": "string", "maxLength": 400},
                "target_audience": {"type": "string", "maxLength": 240},
                "curiosity_gap": {"type": "string", "maxLength": 240},
                "emotional_engine": {"type": "string", "maxLength": 180},
                "selected_title": {"type": "string", "maxLength": 100},
                "selected_title_family": {"type": "string", "enum": ["curiosity", "conflict", "reversal"]},
                "selected_thumbnail_concept": {"type": "string", "maxLength": 260},
                "selected_thumbnail_family": {"type": "string", "enum": ["curiosity", "conflict", "reversal"]},
                "opening_visual": {"type": "string", "maxLength": 320},
                "opening_line": {"type": "string", "maxLength": 220},
                "first_30_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["promise", "zero_to_five", "five_to_fifteen", "fifteen_to_thirty"],
                  "properties": {
                    "promise": {"type": "string", "maxLength": 220},
                    "zero_to_five": {"type": "string", "maxLength": 260},
                    "five_to_fifteen": {"type": "string", "maxLength": 260},
                    "fifteen_to_thirty": {"type": "string", "maxLength": 260}
                  }
                },
                "package_scores": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["clickability", "story_potential", "audience_size"],
                  "properties": {
                    "clickability": {"type": "number", "minimum": 0, "maximum": 1},
                    "story_potential": {"type": "number", "minimum": 0, "maximum": 1},
                    "audience_size": {"type": "number", "minimum": 0, "maximum": 1}
                  }
                },
                "genre": {"type": "string", "enum": ["moral_story", "drama", "true_story", "short_story"]},
                "image_style": {"type": "string", "maxLength": 80},
                "story_hook": {"type": "string", "maxLength": 600},
                "act_titles": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 120}},
                "retention_beats": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["at_fraction", "device"],
                    "properties": {
                      "at_fraction": {"type": "number", "minimum": 0, "maximum": 1},
                      "device": {"type": "string", "maxLength": 300}
                    }
                  }
                },
                "next_video_bridge": {"type": "string", "maxLength": 220}
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["views", "average_view_percentage", "click_through_rate", "retention_5s", "retention_15s", "retention_30s", "subscribers_gained", "likes", "comments"],
              "properties": {
                "views": {"type": "integer", "minimum": 0},
                "estimated_minutes_watched": {"type": "number", "minimum": 0},
                "average_view_duration_sec": {"type": "number", "minimum": 0},
                "average_view_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                "impressions": {"type": ["integer", "null"], "minimum": 0},
                "click_through_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "retention_5s": {"type": ["number", "null"], "minimum": 0},
                "retention_15s": {"type": ["number", "null"], "minimum": 0},
                "retention_30s": {"type": ["number", "null"], "minimum": 0},
                "retention_events": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "elapsed_ratio", "audience_watch_ratio", "delta"],
                    "properties": {
                      "kind": {"type": "string", "enum": ["spike", "dip"]},
                      "elapsed_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                      "audience_watch_ratio": {"type": "number", "minimum": 0},
                      "delta": {"type": "number"}
                    }
                  }
                },
                "subscribers_gained": {"type": "integer"},
                "likes": {"type": "integer", "minimum": 0},
                "comments": {"type": "integer", "minimum": 0},
                "shares": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
