{
  "schema_id": "explanation_plan",
  "version": "1.7.0",
  "status": "active",
  "description": "Semantic-representation plan. Newly-authored scenes choose a concrete/domain/quantitative/spatial renderer or explicit animated text; generic diagram geometry is no longer the fallback. Semantic fields are conditionally required when representation_mode is present so old resumed plan payloads can cross the version boundary and deterministically degrade to animated text instead of failing before render. 1.7.0 adds composition_mode \"character-room\": a scene with no visual worth diagramming skips the diagram entirely and shows both characters full-screen, performing in a real room via the same cinematic-puppet renderer the standalone cartoon graph uses -- rather than shrinking them into a bust panel beside an empty or unrelated diagram.",
  "produced_by": ["explanation_visual_planner", "explanation_plan_reviser", "explanation_plan_release"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SemanticVisualPlanArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes"],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_index", "template_category", "scene_role", "visual_operation", "visual_primitive",
            "visual_state", "composition_mode", "explanation_title", "model_elements", "model_relations",
            "state_before", "state_after", "key_text", "character_cut_in", "sound_cue"
          ],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "template_category": { "type": "string", "const": "explanation" },
            "scene_role": {
              "type": "string",
              "enum": ["character-hook", "diagram-build", "process-flow", "object-state-change", "comparison", "kinetic-emphasis", "character-reaction", "recap"]
            },
            "visual_operation": {
              "type": "string",
              "enum": ["stack", "timeline", "counter", "compress", "group", "sort", "scale-compare", "payoff"]
            },
            "visual_primitive": {
              "type": "string",
              "enum": ["particles", "rays", "wave", "horizon", "spectrum", "path", "shells", "objects", "network", "hierarchy", "one-to-many", "many-to-one", "facets-around-center", "overlapping-sets", "nested-context", "cycle", "cause-chain", "before-after", "map", "timeline", "quantity", "physical-transformation"],
              "description": "Compatibility/selection metadata. For semantic 1.6.0 scenes, representation_mode + scene_blueprint own production rendering."
            },
            "visual_state": { "type": "string", "enum": ["hypothesis", "contradiction", "mechanism", "qualification", "payoff"] },
            "composition_mode": {
              "type": "string",
              "enum": ["bookend", "full-model", "reaction", "character-room"],
              "description": "Frame ownership mode. Bookends show both characters, full-model gives the graphic most of the canvas, reaction allows a deliberate character return, character-room drops the diagram entirely and stages both characters full-screen in a real room."
            },
            "explanation_title": { "type": "string", "maxLength": 52 },
            "model_elements": {
              "type": "array", "maxItems": 4,
              "items": { "type": "string", "minLength": 1, "maxLength": 32 }
            },
            "model_relations": {
              "type": "array", "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["from_element", "to_element", "kind"],
                "properties": {
                  "from_element": { "type": "integer", "minimum": 0, "maximum": 3 },
                  "to_element": { "type": "integer", "minimum": 0, "maximum": 3 },
                  "kind": { "type": "string", "enum": ["causes", "blocks", "becomes", "feeds", "contains"] }
                }
              }
            },
            "numeric_value": { "type": ["number", "null"] },
            "state_before": { "type": "string", "maxLength": 32 },
            "state_after": { "type": "string", "maxLength": 32 },
            "key_text": { "type": "string", "maxLength": 48 },
            "character_cut_in": { "type": "string", "enum": ["none", "speaker", "listener", "both"] },
            "sound_cue": { "type": "string", "enum": ["none", "soft-hit", "tick", "whoosh", "pop", "resolve"] },
            "representation_mode": {
              "type": "string",
              "enum": ["concrete-scene", "domain-model", "quantitative", "spatial", "temporal", "kinetic-text"],
              "description": "Viewer-facing representation class. Newly-authored plans must supply this field."
            },
            "scene_blueprint": {
              "type": "string",
              "enum": ["container-object", "molecular-system", "lattice", "particle-system", "flow-system", "cross-section", "mass-volume-comparison", "scale-comparison", "before-after-object", "map", "timeline", "animated-statement"],
              "description": "Reusable semantic renderer family. Unsupported concepts use animated-statement, never arbitrary geometry."
            },
            "visual_claim": {
              "type": "string", "minLength": 4, "maxLength": 180,
              "description": "The single proposition the scene must make visually true."
            },
            "visual_actions": {
              "type": "array", "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["actor", "action", "target", "anchor_phrase"],
                "properties": {
                  "actor": { "type": "string", "minLength": 1, "maxLength": 48 },
                  "action": {
                    "type": "string",
                    "enum": ["enter", "exit", "move", "rise", "sink", "drop", "rotate", "expand", "contract", "fill", "drain", "freeze", "melt", "assemble", "disassemble", "connect", "disconnect", "bond", "break-bond", "rearrange", "flow", "scatter", "cluster", "highlight", "compare", "reveal", "transform", "settle", "cool", "warm", "slow"]
                  },
                  "target": { "type": "string", "maxLength": 48 },
                  "anchor_phrase": { "type": "string", "minLength": 1, "maxLength": 96 }
                }
              }
            },
            "entity_refs": {
              "type": "array", "maxItems": 4, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "description": "Stable episode_visual_model entity ids in the same order as model_elements. Optional only for resumed pre-ontology plans."
            },
            "listener_actor_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 40 },
            "speaker_emotion": { "type": "string", "enum": ["neutral", "happy", "amused", "skeptical", "confused", "concerned", "sad", "angry", "surprised", "scared", "thinking", "annoyed"] },
            "speaker_gesture": { "type": "string", "enum": ["idle", "explain", "point-left", "point-right", "shrug", "hands-open", "surprised", "thinking", "facepalm", "celebrate"] },
            "speaker_gaze_target": { "type": "string", "enum": ["auto", "camera", "left", "right", "up", "down", "away"] },
            "listener_emotion": { "type": "string", "enum": ["neutral", "happy", "amused", "skeptical", "confused", "concerned", "sad", "angry", "surprised", "scared", "thinking", "annoyed"] },
            "listener_gesture": { "type": "string", "enum": ["idle", "explain", "point-left", "point-right", "shrug", "hands-open", "surprised", "thinking", "facepalm", "celebrate"] },
            "listener_gaze_target": { "type": "string", "enum": ["auto", "camera", "left", "right", "up", "down", "away"] },
            "background_location": {
              "type": "string",
              "enum": [
                "airplane-cabin", "airport", "airport-gate", "bathroom", "bedroom", "cafe",
                "classroom", "engineering-lab", "generic-room", "hallway", "hospital-room",
                "kitchen", "library", "living-room", "office", "park", "school-hallway",
                "shop", "street", "studio"
              ],
              "description": "Only meaningful for composition_mode \"character-room\" -- picks which room the cinematic-puppet renderer stages the characters in. Omitted or ignored on every other composition_mode; defaults to \"studio\" when absent."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "representation_mode": {} },
                "required": ["representation_mode"]
              },
              "then": {
                "properties": {
                  "representation_mode": {},
                  "scene_blueprint": {},
                  "visual_claim": {},
                  "visual_actions": {}
                },
                "required": ["representation_mode", "scene_blueprint", "visual_claim", "visual_actions"]
              }
            },
            {
              "if": { "properties": { "composition_mode": { "enum": ["bookend", "reaction", "character-room"] } }, "required": ["composition_mode"] },
              "then": {
                "properties": {
                  "listener_actor_id": {},
                  "speaker_emotion": {},
                  "speaker_gesture": {},
                  "speaker_gaze_target": {},
                  "listener_emotion": {},
                  "listener_gesture": {},
                  "listener_gaze_target": {}
                },
                "required": ["listener_actor_id", "speaker_emotion", "speaker_gesture", "speaker_gaze_target", "listener_emotion", "listener_gesture", "listener_gaze_target"]
              }
            },
            {
              "if": { "anyOf": [
                { "properties": { "visual_operation": { "const": "counter" } }, "required": ["visual_operation"] },
                { "properties": { "visual_primitive": { "const": "quantity" } }, "required": ["visual_primitive"] }
              ] },
              "then": { "required": ["numeric_value"], "properties": { "numeric_value": { "type": "number" } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "kinetic-text" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "const": "animated-statement" }, "visual_actions": { "type": "array", "maxItems": 0 } } },
              "else": { "properties": { "visual_actions": { "type": "array", "minItems": 1 } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "concrete-scene" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "enum": ["container-object", "before-after-object"] } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "domain-model" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "enum": ["molecular-system", "lattice", "particle-system", "flow-system"] } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "quantitative" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "enum": ["mass-volume-comparison", "scale-comparison"] } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "spatial" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "enum": ["cross-section", "map"] } } }
            },
            {
              "if": { "properties": { "representation_mode": { "const": "temporal" } }, "required": ["representation_mode"] },
              "then": { "properties": { "scene_blueprint": { "type": "string", "const": "timeline" } } }
            },
            {
              "if": { "properties": { "composition_mode": { "const": "character-room" } }, "required": ["composition_mode"] },
              "then": { "properties": { "character_cut_in": { "const": "both" } } }
            }
          ]
        }
      }
    }
  }
}
