{
  "schema_id":"visual_timeline","version":"1.0.0","status":"active",
  "description":"RFC 0010 render-ready timeline. Merges measured voice timing with the selected visual for every beat and records absolute episode timing without changing the production scene contract.",
  "produced_by":["visual_timeline"],
  "json_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"VisualTimelineArtifact","type":"object","additionalProperties":false,"required":["beats","total_duration_sec"],"properties":{
    "beats":{"type":"array","minItems":1,"maxItems":400,"items":{"type":"object","additionalProperties":false,"required":["id","ordinal","scene_index","beat_index","scene_start_sec","scene_end_sec","absolute_start_sec","absolute_end_sec","duration_sec","audio_uri","audio_media_type","resolved_mode","narration","viewer_takeaway","continuity_group","continuity_entities","composition","camera_treatment","subject_placement","explanatory_pattern"],"properties":{
      "id":{"type":"string","pattern":"^beat_[0-9]{3,4}$"},"ordinal":{"type":"integer","minimum":0},"scene_index":{"type":"integer","minimum":0},"beat_index":{"type":"integer","minimum":0},
      "scene_start_sec":{"type":"number","minimum":0},"scene_end_sec":{"type":"number","exclusiveMinimum":0},"absolute_start_sec":{"type":"number","minimum":0},"absolute_end_sec":{"type":"number","exclusiveMinimum":0},"duration_sec":{"type":"number","exclusiveMinimum":0},
      "audio_uri":{"type":"string","pattern":"^blob://sha256:[0-9a-f]{64}$"},"audio_media_type":{"type":"string","enum":["audio/mpeg","audio/wav","audio/ogg","audio/aac","audio/flac","audio/l16"]},
      "resolved_mode":{"type":"string","enum":["stock_video","generated_image","motion_graphic","generated_video"]},"image_uri":{"type":"string","pattern":"^blob://sha256:[0-9a-f]{64}$"},"video_uri":{"type":"string","pattern":"^blob://sha256:[0-9a-f]{64}$"},"preview_uri":{"type":"string","pattern":"^blob://sha256:[0-9a-f]{64}$"},"template_category":{"type":"string","enum":["explanation"]},"template_data":{"type":"string","maxLength":10000},
      "narration":{"type":"string","minLength":1,"maxLength":600},"viewer_takeaway":{"type":"string","minLength":1,"maxLength":300},"continuity_group":{"type":"string","maxLength":80},"continuity_entities":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":64}},
      "composition":{"type":"string","maxLength":80},"camera_treatment":{"type":"string","maxLength":80},"subject_placement":{"type":"string","maxLength":80},"explanatory_pattern":{"type":"string","maxLength":80}
    }}},
    "total_duration_sec":{"type":"number","exclusiveMinimum":0}
  }}
}
