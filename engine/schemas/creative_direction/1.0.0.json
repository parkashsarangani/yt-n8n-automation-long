{
  "schema_id": "creative_direction",
  "version": "1.0.0",
  "status": "draft",
  "description": "Structured creative direction for cartoon episodes: character voice roles, callback loop, scene-level foreground prop authority, blocking intent, metaphor intent, and performance notes. This artifact is consumed directly by the visual planner and cartoon scene compiler so taste decisions do not have to be inferred from dialogue text.",
  "produced_by": ["cartoon_creative_director"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CartoonCreativeDirectionArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["character_roles", "callback", "scenes"],
    "properties": {
      "character_roles": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["character_id", "comic_role", "voice_markers", "reaction_pattern"],
          "properties": {
            "character_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 40 },
            "comic_role": { "type": "string", "minLength": 3, "maxLength": 100, "description": "Distinct role in the exchange, e.g. impulsive/self-aware, dry/observant, anxious/overprepared." },
            "voice_markers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 40 },
              "description": "Concrete wording or rhythm markers visible in this character's lines, not abstract traits only."
            },
            "reaction_pattern": { "type": "string", "minLength": 3, "maxLength": 140, "description": "How this character tends to react on screen in this episode." }
          }
        }
      },
      "callback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seed", "escalation", "payoff"],
        "properties": {
          "seed": { "type": "string", "minLength": 1, "maxLength": 140 },
          "escalation": { "type": "string", "minLength": 1, "maxLength": 140 },
          "payoff": { "type": "string", "minLength": 1, "maxLength": 140 }
        }
      },
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "scene_function", "energy_beat", "foreground_prop", "blocking", "metaphor", "callback_role", "performance_note"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "scene_function": { "type": "string", "minLength": 3, "maxLength": 80 },
            "energy_beat": { "type": "string", "minLength": 3, "maxLength": 80, "description": "Editorial rhythm role, such as hook, denial, temptation, mechanism, practical swap, callback payoff." },
            "foreground_prop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "motion", "anchor", "action"],
              "properties": {
                "type": { "type": "string", "minLength": 2, "maxLength": 40 },
                "state": { "type": "string", "minLength": 2, "maxLength": 60 },
                "motion": { "type": "string", "enum": ["none", "pulse", "glow", "tremble", "slide-away", "thumb-hover", "open", "close", "bounce"] },
                "anchor": { "type": "string", "enum": ["hand", "table", "foreground", "background", "left", "right", "center", "none"] },
                "action": { "type": "string", "minLength": 2, "maxLength": 160 }
              }
            },
            "blocking": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker_position", "listener_position", "prop_position", "power_shift"],
              "properties": {
                "speaker_position": { "type": "string", "enum": ["left", "right", "center", "offscreen", "unchanged"] },
                "listener_position": { "type": "string", "enum": ["left", "right", "center", "offscreen", "unchanged"] },
                "prop_position": { "type": "string", "enum": ["foreground-left", "foreground-right", "foreground-center", "background", "table", "hand", "none"] },
                "power_shift": { "type": "string", "minLength": 2, "maxLength": 120 }
              }
            },
            "metaphor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "label", "emotional_beat"],
              "properties": {
                "type": { "type": "string", "enum": ["none", "metaphor-cutaway", "thought-bubble", "callback-card", "reaction-pop", "screen-change"] },
                "label": { "type": "string", "maxLength": 80 },
                "emotional_beat": { "type": "string", "maxLength": 120 }
              }
            },
            "callback_role": { "type": "string", "enum": ["none", "seed", "escalation", "payoff"] },
            "performance_note": { "type": "string", "minLength": 2, "maxLength": 180 }
          }
        }
      }
    }
  }
}
