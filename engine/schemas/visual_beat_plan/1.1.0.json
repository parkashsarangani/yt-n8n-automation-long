{
  "schema_id": "visual_beat_plan",
  "version": "1.1.0",
  "status": "active",
  "description": "RFC 0010 visual source of truth. Splits narration into semantic/retention beats and declares observable content, candidate diversity, routing, continuity, and 20-30s novelty intent without performing media side effects. Adds asset_brief.semantic_scene: the structured axis/marker/step data a deterministic explanatory graphic is drawn from, plus its cross-beat sequence identity, so a motion graphic renders the beat's actual quantities instead of generic geometry.",
  "produced_by": ["visual_director"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VisualBeatPlanArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["beats"],
    "properties": {
      "beats": {
        "type": "array",
        "minItems": 1,
        "maxItems": 400,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id","scene_index","beat_index","start_sec","end_sec","narration","context","intent","visual_contract","routing","continuity","retention","asset_brief"],
          "properties": {
            "id": {"type":"string","pattern":"^beat_[0-9]{3,4}$"},
            "scene_index": {"type":"integer","minimum":0},
            "beat_index": {"type":"integer","minimum":0},
            "start_sec": {"type":"number","minimum":0},
            "end_sec": {"type":"number","exclusiveMinimum":0},
            "narration": {"type":"string","minLength":1,"maxLength":600},
            "context": {
              "type":"object","additionalProperties":false,"required":["previous","next"],
              "properties":{"previous":{"type":"string","maxLength":600},"next":{"type":"string","maxLength":600}}
            },
            "intent": {
              "type":"object","additionalProperties":false,"required":["purpose","information","emotion","importance"],
              "properties": {
                "purpose":{"type":"string","enum":["ESTABLISH","EXPLAIN","MAKE_SCALE_INTUITIVE","SHOW_CAUSE","SHOW_EFFECT","SHOW_PROCESS","SHOW_LOCATION","SHOW_EVIDENCE","BUILD_SUSPENSE","REVEAL","EMOTIONALIZE","CONTRAST","TRANSITION","PAYOFF"]},
                "information":{"type":"string","minLength":1,"maxLength":400},
                "emotion":{"type":"string","enum":["neutral","curiosity","awe","tension","unease","surprise","empathy","urgency","relief","satisfaction"]},
                "importance":{"type":"number","minimum":0,"maximum":1}
              }
            },
            "visual_contract": {
              "type":"object","additionalProperties":false,"required":["required","forbidden","required_action","viewer_takeaway"],
              "properties": {
                "required":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":120}},
                "forbidden":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":120}},
                "required_action":{"type":"string","maxLength":220},
                "viewer_takeaway":{"type":"string","minLength":1,"maxLength":300}
              }
            },
            "routing": {
              "type":"object","additionalProperties":false,"required":["preferred","fallback","image_style"],
              "properties": {
                "preferred":{"type":"string","enum":["stock_video","generated_image","motion_graphic","generated_video"]},
                "fallback":{"type":"string","enum":["stock_video","generated_image","motion_graphic","generated_video"]},
                "image_style":{"type":"string","enum":["realistic","illustration","not_applicable"]}
              }
            },
            "continuity": {
              "type":"object","additionalProperties":false,"required":["group","entities"],
              "properties": {
                "group":{"type":"string","maxLength":80},
                "entities":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"}}
              }
            },
            "retention": {
              "type":"object","additionalProperties":false,"required":["novelty_required","visual_change_strength","composition","camera_treatment","subject_placement","explanatory_pattern"],
              "properties": {
                "novelty_required":{"type":"boolean"},
                "visual_change_strength":{"type":"number","minimum":0,"maximum":1},
                "composition":{"type":"string","enum":["wide_environment","medium_action","close_detail","subject_off_center","overhead","split_comparison","diagrammatic","map","timeline","full_frame_reveal"]},
                "camera_treatment":{"type":"string","enum":["static","slow_push","slow_pull","pan","tracking","handheld","aerial","macro","diagram_motion","kinetic_reveal"]},
                "subject_placement":{"type":"string","enum":["center","left_third","right_third","foreground","background","full_frame","split","not_applicable"]},
                "explanatory_pattern":{"type":"string","enum":["environment","action","detail","comparison","timeline","map","counter","cause_effect","process","evidence","character_reaction","reveal"]}
              }
            },
            "asset_brief": {
              "type":"object","additionalProperties":false,"required":["query","query_variants","generation_prompt","generation_variants","generated_video_prompt","motion_graphic_brief"],
              "properties": {
                "query":{"type":"string","maxLength":240},
                "query_variants":{"type":"array","minItems":3,"maxItems":5,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":240}},
                "generation_prompt":{"type":"string","maxLength":1200},
                "generation_variants":{"type":"array","minItems":3,"maxItems":5,"uniqueItems":true,"items":{"type":"string","minLength":10,"maxLength":1200}},
                "generated_video_prompt":{"type":"string","maxLength":1600},
                "motion_graphic_brief":{"type":"string","maxLength":900},
                "semantic_scene":{
                  "type":"object","additionalProperties":false,"required":["kind","caption"],
                  "description":"Structured data a deterministic explanatory graphic is drawn from. `kind` decides which other fields are required; the engine rejects a scene that cannot be drawn literally and falls back to kinetic text rather than rendering anonymous geometry. Describe WHAT must be visible (quantities, units, named markers, ordered stages) — never pixel positions, colours or layout.",
                  "properties":{
                    "kind":{"type":"string","enum":["scale_comparison","timeline","process","before_after","quantity","kinetic_phrase","none"]},
                    "sequence_id":{"type":"string","maxLength":64,"description":"Beats sharing this id render as ONE evolving composition. A cumulative explanation (establish a scale, then plot one thing on it, then plot another on the SAME scale) must share a sequence_id instead of resetting."},
                    "continuation":{"type":"boolean","description":"True when this beat adds to a sequence an earlier beat established. Inherited axis/markers/steps are redrawn already-complete; only this beat's new entries animate."},
                    "caption":{"type":"string","minLength":1,"maxLength":64,"description":"Short on-screen phrase. NEVER the full viewer_takeaway sentence — a long caption is clipped at the frame edge."},
                    "axis":{
                      "type":"object","additionalProperties":false,"required":["label","unit","max"],
                      "properties":{
                        "label":{"type":"string","minLength":1,"maxLength":40,"description":"What the scale measures, e.g. 'distance'."},
                        "unit":{"type":"string","minLength":1,"maxLength":16,"description":"e.g. 'km'. The scale is drawn with this unit at both ends."},
                        "max":{"type":"number","exclusiveMinimum":0,"description":"Axis maximum in `unit`. The origin is always 0."}
                      }
                    },
                    "markers":{
                      "type":"array","maxItems":4,
                      "items":{
                        "type":"object","additionalProperties":false,"required":["id","label","value"],
                        "properties":{
                          "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$","description":"Stable across the sequence so a later beat can retain this marker."},
                          "label":{"type":"string","minLength":1,"maxLength":40,"description":"Short name, e.g. 'Walking'. Not a sentence."},
                          "value":{"type":"number","description":"Position on the axis, in the axis unit."},
                          "rate_label":{"type":"string","maxLength":24,"description":"The rate that produced `value`, e.g. '5 km/h'."},
                          "time_label":{"type":"string","maxLength":24,"description":"Elapsed time at `value`, e.g. '4 hours' or '< 1 second'."}
                        }
                      }
                    },
                    "equation":{"type":"string","maxLength":48,"description":"The arithmetic spelled out, e.g. '5 × 4 = 20 km'. Drawn large."},
                    "nodes":{
                      "type":"array","maxItems":5,
                      "items":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"label":{"type":"string","minLength":1,"maxLength":40},"sub_label":{"type":"string","maxLength":32}}}
                    },
                    "steps":{
                      "type":"array","maxItems":5,
                      "items":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"label":{"type":"string","minLength":1,"maxLength":40},"sub_label":{"type":"string","maxLength":32}}}
                    },
                    "before":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"label":{"type":"string","minLength":1,"maxLength":60},"sub_label":{"type":"string","maxLength":32}}},
                    "after":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"label":{"type":"string","minLength":1,"maxLength":60},"sub_label":{"type":"string","maxLength":32}}},
                    "items":{
                      "type":"array","maxItems":5,
                      "items":{"type":"object","additionalProperties":false,"required":["id","label","value"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"label":{"type":"string","minLength":1,"maxLength":40},"value":{"type":"number"},"rate_label":{"type":"string","maxLength":24},"time_label":{"type":"string","maxLength":24}}}
                    },
                    "lines":{
                      "type":"array","maxItems":3,
                      "items":{"type":"object","additionalProperties":false,"required":["text","emphasis"],"properties":{"text":{"type":"string","minLength":1,"maxLength":28},"emphasis":{"type":"boolean"}}},
                      "description":"Kinetic-text fallback copy. Exactly one line has emphasis=true — the value or keyword. Never a full sentence."
                    }
                  }
                }
              }
            },
            "hero_role":{"type":"string","enum":["hook","first-escalation","low-point","turn","payoff"]}
          }
        }
      }
    }
  }
}
