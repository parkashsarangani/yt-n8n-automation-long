{
  "schema_id": "visual_beat_assets",
  "version": "1.0.0",
  "status": "active",
  "description": "RFC 0010 benchmark output. Records the resolved visual mode and media/template payload for every visual beat without changing the production render contract.",
  "produced_by": ["visual_beat_assets"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VisualBeatAssetsArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["beats", "summary"],
    "properties": {
      "beats": {
        "type": "array",
        "minItems": 1,
        "maxItems": 400,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scene_index",
            "beat_index",
            "start_sec",
            "end_sec",
            "requested_mode",
            "resolved_mode",
            "status",
            "semantic_verified",
            "narration",
            "viewer_takeaway"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^beat_[0-9]{3,4}$"},
            "scene_index": {"type": "integer", "minimum": 0},
            "beat_index": {"type": "integer", "minimum": 0},
            "start_sec": {"type": "number", "minimum": 0},
            "end_sec": {"type": "number", "exclusiveMinimum": 0},
            "requested_mode": {
              "type": "string",
              "enum": ["stock_video", "generated_image", "motion_graphic", "generated_video"]
            },
            "resolved_mode": {
              "type": ["string", "null"],
              "enum": ["stock_video", "generated_image", "motion_graphic", "generated_video", null]
            },
            "status": {"type": "string", "enum": ["resolved", "fallback", "unavailable"]},
            "semantic_verified": {"type": "boolean"},
            "narration": {"type": "string", "minLength": 1, "maxLength": 600},
            "viewer_takeaway": {"type": "string", "minLength": 1, "maxLength": 300},
            "image_uri": {"type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$"},
            "template_category": {"type": "string", "enum": ["motion_graphic"]},
            "template_data": {"type": "string", "maxLength": 5000},
            "note": {"type": "string", "maxLength": 500}
          }
        }
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolved", "fallbacks", "unavailable", "generated_images", "motion_graphics"],
        "properties": {
          "resolved": {"type": "integer", "minimum": 0},
          "fallbacks": {"type": "integer", "minimum": 0},
          "unavailable": {"type": "integer", "minimum": 0},
          "generated_images": {"type": "integer", "minimum": 0},
          "motion_graphics": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
