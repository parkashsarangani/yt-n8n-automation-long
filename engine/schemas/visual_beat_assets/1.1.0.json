{
  "schema_id": "visual_beat_assets",
  "version": "1.1.0",
  "status": "active",
  "description": "RFC 0010 resolved beat assets with actual candidate QA, exact stock/generated-video segment metadata, deterministic motion-graphic instructions, and additive sourcing-efficiency telemetry for development smoke evaluation.",
  "produced_by": ["visual_beat_assets"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VisualBeatAssetsArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["beats", "summary"],
    "properties": {
      "beats": {
        "type": "array",
        "minItems": 1,
        "maxItems": 400,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "scene_index", "beat_index", "start_sec", "end_sec",
            "requested_mode", "resolved_mode", "status", "semantic_verified",
            "narration", "viewer_takeaway", "composition", "camera_treatment",
            "subject_placement", "explanatory_pattern"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^beat_[0-9]{3,4}$"},
            "scene_index": {"type": "integer", "minimum": 0},
            "beat_index": {"type": "integer", "minimum": 0},
            "start_sec": {"type": "number", "minimum": 0},
            "end_sec": {"type": "number", "exclusiveMinimum": 0},
            "requested_mode": {"type": "string", "enum": ["stock_video", "generated_image", "motion_graphic", "generated_video"]},
            "resolved_mode": {"type": ["string", "null"], "enum": ["stock_video", "generated_image", "motion_graphic", "generated_video", null]},
            "status": {"type": "string", "enum": ["resolved", "fallback", "unavailable"]},
            "semantic_verified": {"type": "boolean"},
            "narration": {"type": "string", "minLength": 1, "maxLength": 600},
            "viewer_takeaway": {"type": "string", "minLength": 1, "maxLength": 300},
            "image_uri": {"type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$"},
            "video_uri": {"type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$"},
            "preview_uri": {"type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$"},
            "source_provider": {"type": "string", "maxLength": 80},
            "source_id": {"type": "string", "maxLength": 160},
            "source_url": {"type": "string", "maxLength": 1000},
            "source_in_sec": {"type": "number", "minimum": 0},
            "source_out_sec": {"type": "number", "exclusiveMinimum": 0},
            "template_category": {"type": "string", "enum": ["explanation"]},
            "template_data": {"type": "string", "maxLength": 10000},
            "semantic_match": {"type": "number", "minimum": 0, "maximum": 1},
            "action_match": {"type": "number", "minimum": 0, "maximum": 1},
            "visual_interest": {"type": "number", "minimum": 0, "maximum": 1},
            "continuity": {"type": "number", "minimum": 0, "maximum": 1},
            "generic_filler": {"type": "boolean"},
            "why_failure": {"type": "boolean"},
            "composition": {"type": "string", "maxLength": 80},
            "camera_treatment": {"type": "string", "maxLength": 80},
            "subject_placement": {"type": "string", "maxLength": 80},
            "explanatory_pattern": {"type": "string", "maxLength": 80},
            "candidate_count": {"type": "integer", "minimum": 0, "maximum": 200},
            "first_acceptable_candidate_index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "1-based rank of the first provider candidate that cleared the mode's actual visual gate. For stock this counts source videos, not internal sampled windows."
            },
            "search_query_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Stock query variants consumed before a verified source/window was selected."
            },
            "mode_attempt_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "description": "Number of representation modes actually attempted: preferred plus at most one agent-declared alternate."
            },
            "note": {"type": "string", "maxLength": 1000}
          }
        }
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolved", "fallbacks", "unavailable", "stock_videos", "generated_images", "motion_graphics", "generated_videos", "generic_filler", "why_failures"],
        "properties": {
          "resolved": {"type": "integer", "minimum": 0},
          "fallbacks": {"type": "integer", "minimum": 0},
          "unavailable": {"type": "integer", "minimum": 0},
          "stock_videos": {"type": "integer", "minimum": 0},
          "generated_images": {"type": "integer", "minimum": 0},
          "motion_graphics": {"type": "integer", "minimum": 0},
          "generated_videos": {"type": "integer", "minimum": 0},
          "generic_filler": {"type": "integer", "minimum": 0},
          "why_failures": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
