{
  "schema_id": "editor_handoff",
  "version": "1.0.0",
  "status": "active",
  "description": "The package handed to the human editor: a Drive folder holding the draft video, transcript, and licensing/credit template, plus the same per-scene beat list so the operator can review it without opening Drive.",
  "produced_by": ["editor_package"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EditorHandoffArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["drive_folder_id", "drive_folder_url", "scenes"],
    "properties": {
      "drive_folder_id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "drive_folder_url": { "type": "string", "minLength": 1, "maxLength": 400 },
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "point", "start_sec", "duration_sec", "visual_summary"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "point": { "type": "string", "minLength": 1, "maxLength": 420 },
            "start_sec": { "type": "number", "minimum": 0 },
            "duration_sec": { "type": "number", "minimum": 0 },
            "visual_summary": { "type": "string", "minLength": 1, "maxLength": 400 },
            "search_terms": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}
