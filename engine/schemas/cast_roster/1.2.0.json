{
  "schema_id": "cast_roster",
  "version": "1.2.0",
  "status": "active",
  "description": "Recurring cast with production identity plus a backward-compatible character bible for dialogue differentiation and relationship chemistry.",
  "produced_by": [
    "human",
    "cast_loader"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CastRosterArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "characters"
    ],
    "properties": {
      "characters": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "character_id",
            "name",
            "voice_id",
            "rig"
          ],
          "properties": {
            "character_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 40
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "voice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "rig": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "personality": {
              "type": "string",
              "maxLength": 500
            },
            "default_expression": {
              "type": "string",
              "enum": [
                "normal",
                "angry",
                "surprised"
              ]
            },
            "visual_description": {
              "type": "string",
              "maxLength": 700
            },
            "thumbnail_traits": {
              "type": "string",
              "maxLength": 400
            },
            "color_palette": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "worldview": {
              "type": "string",
              "maxLength": 500,
              "description": "Stable lens through which this character interprets problems."
            },
            "comic_style": {
              "type": "string",
              "maxLength": 400,
              "description": "Distinct humor mechanism; not interchangeable generic banter."
            },
            "speech_rhythm": {
              "type": "string",
              "maxLength": 400,
              "description": "Sentence length, interruption, vocabulary and pacing tendencies."
            },
            "strength": {
              "type": "string",
              "maxLength": 400
            },
            "blind_spot": {
              "type": "string",
              "maxLength": 400
            },
            "scene_drive": {
              "type": "string",
              "maxLength": 400,
              "description": "What this character normally wants from an explanation scene."
            },
            "relationship_dynamic": {
              "type": "string",
              "maxLength": 600,
              "description": "How this character challenges, trusts and plays off the recurring partner."
            }
          }
        }
      },
      "default_voice_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  }
}
