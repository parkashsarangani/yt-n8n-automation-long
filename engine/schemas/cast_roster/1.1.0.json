{
  "schema_id": "cast_roster",
  "version": "1.1.0",
  "status": "active",
  "description": "Recurring cartoon cast with voice/rig identity plus optional visual descriptors used to keep generated thumbnail artwork consistent across episodes. All 1.0.0 fields remain valid; new fields are additive.",
  "produced_by": ["human", "cast_loader"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CastRosterArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["characters"],
    "properties": {
      "characters": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["character_id", "name", "voice_id", "rig"],
          "properties": {
            "character_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 40
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "voice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "rig": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "personality": {
              "type": "string",
              "maxLength": 300
            },
            "default_expression": {
              "type": "string",
              "enum": ["normal", "angry", "surprised"]
            },
            "visual_description": {
              "type": "string",
              "maxLength": 700,
              "description": "Stable appearance description for thumbnail/image generation: age range, face/head silhouette, skin tone, hair, outfit, body proportions and distinctive accessories. Do not include temporary episode actions or emotions."
            },
            "thumbnail_traits": {
              "type": "string",
              "maxLength": 400,
              "description": "How this recurring character should read at thumbnail scale, such as signature silhouette, expression range and high-contrast clothing accents."
            },
            "color_palette": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "description": "Optional stable character palette for generated artwork consistency."
            }
          }
        }
      },
      "default_voice_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  }
}
