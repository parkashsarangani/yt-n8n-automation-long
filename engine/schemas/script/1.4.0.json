{
  "schema_id": "script",
  "version": "1.4.0",
  "status": "active",
  "description": "Script schema for the comprehension, retention, emotional-entertainment, revision, and deterministic release stages. Payload stays backward compatible while the producer lineage expands.",
  "produced_by": [
    "script_writer",
    "dialogue_script_writer",
    "comprehension_editor",
    "retention_character_editor",
    "emotional_entertainment_editor",
    "script_quality_reviser",
    "script_quality_release",
    "human"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ScriptArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "scenes"
    ],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_index",
            "point",
            "narration"
          ],
          "properties": {
            "scene_index": {
              "type": "integer",
              "minimum": 0
            },
            "act_index": {
              "type": "integer",
              "minimum": 0
            },
            "point": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "What this beat does for the story."
            },
            "narration": {
              "type": "string",
              "minLength": 5,
              "maxLength": 2000
            },
            "is_outro": {
              "type": "boolean"
            },
            "speaker": {
              "type": "string",
              "maxLength": 40,
              "description": "character_id from the run's cast_roster who speaks this line. Absent for single-narrator scripts."
            },
            "emotion": {
              "type": "string",
              "enum": [
                "neutral",
                "happy",
                "angry",
                "surprised",
                "sad",
                "scared"
              ],
              "description": "The speaker's emotional delivery for this line - drives the cartoon renderer's expression/pose choice. Only meaningful alongside \"speaker\"."
            }
          }
        }
      },
      "word_count": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
