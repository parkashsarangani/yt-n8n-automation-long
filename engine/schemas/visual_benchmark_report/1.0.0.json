{
  "schema_id":"visual_benchmark_report","version":"1.0.0","status":"active",
  "description":"RFC 0010 rendered-frame evaluation and blind control-vs-V2 comparison. pass=true only when the original visual relevance/interest kill gate is satisfied.",
  "produced_by":["visual_benchmark_qa"],
  "json_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"VisualBenchmarkReport","type":"object","additionalProperties":false,"required":["pass","failures","beats","summary"],"properties":{
    "pass":{"type":"boolean"},"failures":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":300}},
    "beats":{"type":"array","minItems":1,"maxItems":60,"items":{"type":"object","additionalProperties":false,"required":["id","semantic_match","action_match","visual_interest","continuity","generic_filler","why_failure","repetitive","blind_winner","blind_reason"],"properties":{
      "id":{"type":"string","pattern":"^beat_[0-9]{3,4}$"},
      "semantic_match":{"type":"number","minimum":0,"maximum":1},"action_match":{"type":"number","minimum":0,"maximum":1},"visual_interest":{"type":"number","minimum":0,"maximum":1},"continuity":{"type":"number","minimum":0,"maximum":1},
      "generic_filler":{"type":"boolean"},"why_failure":{"type":"boolean"},"repetitive":{"type":"boolean"},
      "blind_winner":{"type":"string","enum":["v2","control","tie"]},"blind_reason":{"type":"string","maxLength":500},
      "v2_blind_semantic":{"type":"number","minimum":0,"maximum":1},"v2_blind_interest":{"type":"number","minimum":0,"maximum":1},"control_blind_semantic":{"type":"number","minimum":0,"maximum":1},"control_blind_interest":{"type":"number","minimum":0,"maximum":1},
      "qa_reason":{"type":"string","maxLength":500}
    }}},
    "summary":{"type":"object","additionalProperties":false,"required":["beat_count","mean_semantic_match","min_semantic_match","mean_visual_interest","min_visual_interest","why_failures","repetitive_count","repetitive_ratio","continuity_errors","generic_filler_count","generic_filler_ratio","v2_wins","control_wins","ties"],"properties":{
      "beat_count":{"type":"integer","minimum":1},"mean_semantic_match":{"type":"number","minimum":0,"maximum":1},"min_semantic_match":{"type":"number","minimum":0,"maximum":1},"mean_visual_interest":{"type":"number","minimum":0,"maximum":1},"min_visual_interest":{"type":"number","minimum":0,"maximum":1},
      "why_failures":{"type":"integer","minimum":0},"repetitive_count":{"type":"integer","minimum":0},"repetitive_ratio":{"type":"number","minimum":0,"maximum":1},"continuity_errors":{"type":"integer","minimum":0},"generic_filler_count":{"type":"integer","minimum":0},"generic_filler_ratio":{"type":"number","minimum":0,"maximum":1},"v2_wins":{"type":"integer","minimum":0},"control_wins":{"type":"integer","minimum":0},"ties":{"type":"integer","minimum":0}
    }}
  }}
}
