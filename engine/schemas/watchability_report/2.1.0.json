{
  "schema_id": "watchability_report",
  "version": "2.1.0",
  "status": "active",
  "description": "RFC 0009 watchability report with the target duration used for evaluation persisted on the artifact. This keeps unattended best-of-N ranking, revision directives and deterministic release on the same duration-aware rubric without coupling consumers back to intent lookup.",
  "produced_by": ["watchability_critic"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "WatchabilityReport",
    "type": "object",
    "additionalProperties": false,
    "required": ["target_duration_sec", "verdict", "scores", "weakest_dimension", "summary", "abandon_recommended", "abandon_reason"],
    "properties": {
      "target_duration_sec": {"type": "integer", "minimum": 15, "maximum": 7200},
      "verdict": {"type": "string", "enum": ["pass", "revise", "abandon"]},
      "scores": {
        "type": "object", "additionalProperties": false,
        "required": ["hook", "first_30_fidelity", "package_fidelity", "suspense", "watchability", "entertainment", "payoff", "youtube_fit"],
        "properties": {
          "hook": {"type": "number", "minimum": 0, "maximum": 1},
          "first_30_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
          "package_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
          "suspense": {"type": "number", "minimum": 0, "maximum": 1},
          "watchability": {"type": "number", "minimum": 0, "maximum": 1},
          "entertainment": {"type": "number", "minimum": 0, "maximum": 1},
          "payoff": {"type": "number", "minimum": 0, "maximum": 1},
          "youtube_fit": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "weakest_dimension": {"type": "string", "enum": ["hook", "first_30_fidelity", "package_fidelity", "suspense", "watchability", "entertainment", "payoff", "youtube_fit"]},
      "summary": {"type": "string", "minLength": 10, "maxLength": 800},
      "abandon_recommended": {"type": "boolean"},
      "abandon_reason": {"type": "string", "maxLength": 500}
    }
  }
}
