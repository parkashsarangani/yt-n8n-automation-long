{
  "schema_id": "channel_insights",
  "version": "1.1.0",
  "status": "active",
  "description": "RFC 0009 turns analytics into editorial memory: evidence-backed patterns must state the observed behavior, concrete implication for future packages/scripts, and confidence. Adds hook/retention/emotional/session/packaging areas without changing the underlying measurement facts.",
  "produced_by": ["channel_strategist"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ChannelInsightsArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["sample_size", "confidence_note", "guidance", "editorial_memory"],
    "properties": {
      "sample_size": {"type": "integer", "minimum": 0},
      "confidence_note": {"type": "string", "minLength": 5, "maxLength": 500},
      "guidance": {
        "type": "array", "maxItems": 10,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["area", "advice", "evidence"],
          "properties": {
            "area": {"type": "string", "enum": ["topic", "title", "thumbnail", "packaging", "hook", "retention", "structure", "emotional_engine", "length", "session"]},
            "advice": {"type": "string", "minLength": 10, "maxLength": 500},
            "evidence": {"type": "string", "minLength": 5, "maxLength": 500}
          }
        }
      },
      "editorial_memory": {
        "type": "array", "maxItems": 10,
        "description": "Causal/actionable hypotheses derived from measured episodes. These are not permanent truths: each carries evidence and confidence so later data can overturn it.",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["pattern", "implication", "evidence", "confidence"],
          "properties": {
            "pattern": {"type": "string", "minLength": 10, "maxLength": 500},
            "implication": {"type": "string", "minLength": 10, "maxLength": 500},
            "evidence": {"type": "string", "minLength": 5, "maxLength": 600},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      },
      "avoid": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 5, "maxLength": 260}}
    }
  }
}
