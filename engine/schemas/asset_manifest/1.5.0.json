{
  "schema_id": "asset_manifest",
  "version": "1.5.0",
  "status": "active",
  "description": "Watchability-oriented hybrid asset manifest: bounded AI shot packs retain deterministic explanation metadata while adding voice timing, semantic shot windows, shared visual-style tokens, stable entity identities, explicit visible-character telemetry, continuity groups, and opening-hook evidence.",
  "produced_by": ["asset_collector", "cartoon_scene_compiler", "hybrid_visual_assets"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HybridAssetManifestArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes", "degraded_count"],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 300,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "source"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "image_uri": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" },
            "image_uris": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" } },
            "video_uri": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" },
            "source": { "type": "string", "enum": ["primary", "fallback", "placeholder", "template"] },
            "prompt": { "type": "string", "maxLength": 3000 },
            "template_category": { "type": "string", "maxLength": 50 },
            "template_data": { "type": "string", "maxLength": 8000, "description": "JSON-encoded deterministic explanation props. Retained on AI entries so QA still measures the intended explanatory role." },
            "visual_mode": { "type": "string", "enum": ["motion_graphic", "ai_broll"] },
            "continuity_group": { "type": "string", "maxLength": 80 },
            "style_id": { "type": "string", "maxLength": 80 },
            "palette_id": { "type": "string", "maxLength": 80 },
            "entity_ids": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^entity-[a-z0-9-]{1,64}$" } },
            "entity_visual_tokens": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entity_id", "color", "shape"],
                "properties": {
                  "entity_id": { "type": "string", "pattern": "^entity-[a-z0-9-]{1,64}$" },
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "shape": { "type": "string", "enum": ["circle", "diamond", "triangle", "ring", "hexagon", "plus"] }
                }
              }
            },
            "visible_character_ids": {
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": "Characters actually expected to be visible in the rendered scene. AI scenes populate this from the cast supplied to the image prompt; motion scenes populate it from renderer composition metadata when known."
            },
            "duration_sec": { "type": "number", "minimum": 0 },
            "shot_types": { "type": "array", "maxItems": 5, "items": { "type": "string", "enum": ["establishing", "wide", "medium", "close-up", "detail", "reaction", "symbolic", "overhead"] } },
            "shot_segments": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["shot_type", "start_sec", "end_sec", "semantic_text"],
                "properties": {
                  "shot_type": { "type": "string", "enum": ["establishing", "wide", "medium", "close-up", "detail", "reaction", "symbolic", "overhead"] },
                  "start_sec": { "type": "number", "minimum": 0 },
                  "end_sec": { "type": "number", "minimum": 0 },
                  "semantic_text": { "type": "string", "minLength": 1, "maxLength": 240 }
                }
              }
            },
            "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
            "hook_strategy": { "type": "string", "enum": ["ai_question", "motion_transformation", "fallback"] }
          }
        }
      },
      "degraded_count": { "type": "integer", "minimum": 0 }
    }
  }
}
