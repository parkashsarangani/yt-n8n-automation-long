{
  "schema_id": "asset_manifest",
  "version": "1.8.0",
  "status": "active",
  "description": "1.7.0 plus the semantic_visual_assets producer. Semantic renderer intent remains inside the bounded JSON template_data payload, so the manifest scene shape itself is unchanged; the new version preserves the producer allowlist contract without retroactively mutating 1.7.0.",
  "produced_by": ["asset_collector", "cartoon_scene_compiler", "semantic_visual_assets", "hybrid_visual_assets", "illustrated_scene_assets"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SemanticHybridAssetManifestArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes", "degraded_count"],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 300,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "source"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "image_uri": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" },
            "image_uris": {
              "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" }
            },
            "video_uri": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" },
            "source": { "type": "string", "enum": ["primary", "fallback", "placeholder", "template"] },
            "prompt": { "type": "string", "maxLength": 3000 },
            "template_category": { "type": "string", "maxLength": 50 },
            "template_data": {
              "type": "string", "maxLength": 8000,
              "description": "JSON-encoded deterministic explanation props, including semantic representation metadata when present. Retained on AI entries so QA still measures intended explanatory structure."
            },
            "visual_mode": { "type": "string", "enum": ["motion_graphic", "ai_broll"] },
            "continuity_group": { "type": "string", "maxLength": 80 },
            "style_id": { "type": "string", "maxLength": 80 },
            "palette_id": { "type": "string", "maxLength": 80 },
            "entity_ids": {
              "type": "array", "maxItems": 4, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^entity-[a-z0-9-]{1,64}$" }
            },
            "entity_visual_tokens": {
              "type": "array", "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["entity_id", "color"],
                "properties": {
                  "entity_id": { "type": "string", "pattern": "^entity-[a-z0-9-]{1,64}$" },
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
                }
              }
            },
            "entity_icons": {
              "type": "array", "maxItems": 4,
              "description": "Resolved Iconify icons for concrete entities. Renderer-extension metadata is never stored here; it is inserted only into the outbound long-compose request after artifact validation.",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["entity_id", "icon_id", "view_box", "body"],
                "properties": {
                  "entity_id": { "type": "string", "pattern": "^entity-[a-z0-9-]{1,64}$" },
                  "icon_id": { "type": "string", "maxLength": 120 },
                  "view_box": { "type": "string", "maxLength": 40, "pattern": "^0 0 [0-9]+ [0-9]+$" },
                  "body": { "type": "string", "maxLength": 2000 }
                }
              }
            },
            "visible_character_ids": {
              "type": "array", "maxItems": 2, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "duration_sec": { "type": "number", "minimum": 0 },
            "shot_types": {
              "type": "array", "maxItems": 5,
              "items": { "type": "string", "enum": ["establishing", "wide", "medium", "close-up", "detail", "reaction", "symbolic", "overhead"] }
            },
            "shot_segments": {
              "type": "array", "maxItems": 5,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["shot_type", "start_sec", "end_sec", "semantic_text"],
                "properties": {
                  "shot_type": { "type": "string", "enum": ["establishing", "wide", "medium", "close-up", "detail", "reaction", "symbolic", "overhead"] },
                  "start_sec": { "type": "number", "minimum": 0 },
                  "end_sec": { "type": "number", "minimum": 0 },
                  "semantic_text": { "type": "string", "minLength": 1, "maxLength": 240 }
                }
              }
            },
            "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
            "hook_strategy": { "type": "string", "enum": ["ai_question", "motion_transformation", "fallback"] }
          }
        }
      },
      "degraded_count": { "type": "integer", "minimum": 0 }
    }
  }
}
