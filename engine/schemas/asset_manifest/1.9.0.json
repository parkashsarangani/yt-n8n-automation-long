{
  "schema_id": "asset_manifest",
  "version": "1.9.0",
  "status": "active",
  "description": "1.8.0 plus optional RFC 0009 growth fields: per-scene hero shot ids, the widened semantic shot-function vocabulary, and the episode-level visual_review record. Additive on purpose -- asset_manifest is produced by asset_collector and the illustrated worker alike, so making the growth fields required would invalidate every non-illustrated manifest (and did: it broke the manual graph). Enforcement of the growth contract belongs in the qa gate, which can warn or fail, not in serialization, which can only crash.",
  "produced_by": [
    "asset_collector",
    "cartoon_scene_compiler",
    "semantic_visual_assets",
    "hybrid_visual_assets",
    "illustrated_scene_assets",
    "visual_timeline_manifest"
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SemanticHybridAssetManifestArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "scenes",
      "degraded_count"
    ],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 300,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_index",
            "source"
          ],
          "properties": {
            "scene_index": {
              "type": "integer",
              "minimum": 0
            },
            "image_uri": {
              "type": "string",
              "pattern": "^blob://sha256:[0-9a-f]{64}$"
            },
            "image_uris": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^blob://sha256:[0-9a-f]{64}$"
              }
            },
            "video_uri": {
              "type": "string",
              "pattern": "^blob://sha256:[0-9a-f]{64}$"
            },
            "source": {
              "type": "string",
              "enum": [
                "primary",
                "fallback",
                "placeholder",
                "template"
              ]
            },
            "prompt": {
              "type": "string",
              "maxLength": 3000
            },
            "template_category": {
              "type": "string",
              "maxLength": 50
            },
            "template_data": {
              "type": "string",
              "maxLength": 8000,
              "description": "JSON-encoded deterministic explanation props, including semantic representation metadata when present. Retained on AI entries so QA still measures intended explanatory structure."
            },
            "visual_mode": {
              "type": "string",
              "enum": [
                "motion_graphic",
                "ai_broll"
              ]
            },
            "continuity_group": {
              "type": "string",
              "maxLength": 80
            },
            "style_id": {
              "type": "string",
              "maxLength": 80
            },
            "palette_id": {
              "type": "string",
              "maxLength": 80
            },
            "entity_ids": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^entity-[a-z0-9-]{1,64}$"
              }
            },
            "entity_visual_tokens": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity_id",
                  "color"
                ],
                "properties": {
                  "entity_id": {
                    "type": "string",
                    "pattern": "^entity-[a-z0-9-]{1,64}$"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  }
                }
              }
            },
            "entity_icons": {
              "type": "array",
              "maxItems": 4,
              "description": "Resolved Iconify icons for concrete entities. Renderer-extension metadata is never stored here; it is inserted only into the outbound long-compose request after artifact validation.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity_id",
                  "icon_id",
                  "view_box",
                  "body"
                ],
                "properties": {
                  "entity_id": {
                    "type": "string",
                    "pattern": "^entity-[a-z0-9-]{1,64}$"
                  },
                  "icon_id": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "view_box": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^0 0 [0-9]+ [0-9]+$"
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            },
            "visible_character_ids": {
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "duration_sec": {
              "type": "number",
              "minimum": 0
            },
            "shot_types": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "enum": [
                  "establishing",
                  "wide",
                  "medium",
                  "close-up",
                  "detail",
                  "reaction",
                  "symbolic",
                  "overhead",
                  "object-detail",
                  "environmental-consequence",
                  "reveal",
                  "scale-shot",
                  "point-of-view",
                  "silhouette",
                  "location-before-after"
                ]
              }
            },
            "shot_segments": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "shot_type",
                  "start_sec",
                  "end_sec",
                  "semantic_text"
                ],
                "properties": {
                  "shot_type": {
                    "type": "string",
                    "enum": [
                      "establishing",
                      "wide",
                      "medium",
                      "close-up",
                      "detail",
                      "reaction",
                      "symbolic",
                      "overhead"
                    ]
                  },
                  "start_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "semantic_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                }
              }
            },
            "hook_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hook_strategy": {
              "type": "string",
              "enum": [
                "ai_question",
                "motion_transformation",
                "fallback"
              ]
            },
            "hero_shot_ids": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]+:[0-2]$"
              }
            }
          }
        }
      },
      "degraded_count": {
        "type": "integer",
        "minimum": 0
      },
      "visual_review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reviewed_shots",
          "regenerated_shots",
          "remaining_flagged_shots",
          "scores",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "unavailable"
            ]
          },
          "reviewed_shots": {
            "type": "integer",
            "minimum": 0
          },
          "regenerated_shots": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+:[0-2]$"
            }
          },
          "remaining_flagged_shots": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+:[0-2]$"
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opening_visual_strength",
              "scene_relevance",
              "subject_legibility",
              "emotional_readability",
              "shot_variety",
              "visual_redundancy",
              "continuity",
              "style_consistency",
              "ai_artifacts",
              "payoff_visual_strength"
            ],
            "properties": {
              "opening_visual_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scene_relevance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "subject_legibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "emotional_readability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "shot_variety": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "visual_redundancy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "continuity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "style_consistency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ai_artifacts": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "payoff_visual_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 1400
          }
        }
      }
    }
  }
}
