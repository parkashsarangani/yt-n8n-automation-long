{
  "schema_id": "asset_manifest",
  "version": "1.3.0",
  "status": "active",
  "description": "Adds \"template\" to the source enum: a template-category scene (motion graphics or cartoon) no longer runs a stock image/video fetch it would just discard - it is asset_collector's own render instruction, not a degraded fallback. MINOR bump per RFC 0007: purely additive to the enum, existing 1.0.0/1.1.0/1.2.0 artifacts (source always primary/fallback/placeholder) stay valid.",
  "produced_by": ["asset_collector"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AssetManifestArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes", "degraded_count"],
    "properties": {
      "scenes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 300,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_index", "source"],
          "properties": {
            "scene_index": { "type": "integer", "minimum": 0 },
            "image_uri": { "type": "string", "pattern": "^blob://sha256:[0-9a-f]{64}$" },
            "video_uri": {
              "type": "string",
              "pattern": "^blob://sha256:[0-9a-f]{64}$",
              "description": "Real stock footage for this scene. When set, the renderer uses it instead of image_uri."
            },
            "source": { "type": "string", "enum": ["primary", "fallback", "placeholder", "template"] },
            "prompt": { "type": "string", "maxLength": 2000 },
            "template_category": { "type": "string", "maxLength": 50 },
            "template_data": { "type": "string", "maxLength": 5000, "description": "JSON-encoded template props." }
          }
        }
      },
      "degraded_count": { "type": "integer", "minimum": 0 }
    }
  }
}
