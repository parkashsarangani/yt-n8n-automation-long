{
  "schema_id": "episode_direction",
  "version": "2.0.0",
  "status": "active",
  "description": "RFC 0009 breaking contract: narration scenes now carry 1-3 visual shots with semantic shot functions and hero-beat designations. Major because the former single image_prompt/camera_move shape is replaced by required shots and hero_shots.",
  "produced_by": ["episode_director"],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EpisodeDirectionArtifact",
    "type": "object",
    "additionalProperties": false,
    "required": ["scenes", "hero_shots"],
    "properties": {
      "hero_shots": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+:[0-2]$"}},
      "scenes": {
        "type": "array", "minItems": 1, "maxItems": 200,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["scene_index", "shots"],
          "properties": {
            "scene_index": {"type": "integer", "minimum": 0},
            "on_screen_label": {"type": "string", "maxLength": 24},
            "shots": {
              "type": "array", "minItems": 1, "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["shot_index", "image_prompt", "camera_move", "shot_function", "importance"],
                "properties": {
                  "shot_index": {"type": "integer", "minimum": 0, "maximum": 2},
                  "image_prompt": {"type": "string", "minLength": 12, "maxLength": 360},
                  "camera_move": {"type": "string", "enum": ["push-in", "pull-out", "pan-left", "pan-right", "hold"]},
                  "shot_function": {"type": "string", "enum": ["wide", "medium", "close-up", "object-detail", "reaction", "environmental-consequence", "reveal", "scale-shot", "point-of-view", "silhouette", "location-before-after"]},
                  "importance": {"type": "string", "enum": ["normal", "hero"]},
                  "hero_role": {"type": "string", "enum": ["hook", "first-escalation", "low-point", "turn", "payoff"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
