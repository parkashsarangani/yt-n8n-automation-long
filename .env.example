# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. The production deployment supplies these from GitHub secrets/vars.

# Shared FreeLLMAPI instance (owned by the Shorts stack on the same server).
# RFC 0010 pins creative text to a concrete Google model; do not use auto/auto:*.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODEL=gemini-2.5-flash
# Visual QA may still use the shared multimodal router. This is NOT image generation.
FREELLMAPI_VISION_MODEL=auto:smart

# Narration remains on the established ElevenLabs path.
SPEECH_PROVIDER_MODE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Paid reasoning/vision fail-open or direct rollback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# RFC 0010 image generation: fal.ai only. FLUX.2 supports the stronger
# reference-conditioned continuity path required by recurring scenes/entities.
FAL_KEY=
FAL_MODEL=fal-ai/flux-2
# Optional; defaults to ${FAL_MODEL}/edit.
FAL_EDIT_MODEL=
# Premium text-to-video is used only for Visual Director hero/high-value beats.
# This is deliberately separate from the legacy long-compose FAL_VIDEO_MODEL
# (image-to-video), because the two model families have different input contracts.
FAL_TEXT_TO_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# Optional cost-accounting override in USD per generated image.
FAL_PRICE_PER_IMAGE=

# RFC 0010 real-world stock-video candidates. Actual downloaded frames are VLM
# verified and exact source windows are cut before a clip can enter the timeline.
PEXELS_API_KEY=

# Daily production.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_HOUR_UTC=19
SCHEDULE_MEASURE_HOURS=24

# Legacy image-search credentials retained for old/manual workflows only.
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
AMOS_ALLOW_PUBLISH=1

# --- renderer tuning ---------------------------------------------------
# COMPOSE_CONCURRENCY=3
# TZ=Europe/Berlin
