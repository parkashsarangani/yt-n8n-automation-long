# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. The production deployment supplies these from GitHub secrets/vars.

# Shared FreeLLMAPI instance (owned by the Shorts stack on the same server).
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODEL=auto:smart
FREELLMAPI_VISION_MODEL=auto:smart

# Experimental media routing. Production defaults both to FreeLLMAPI. Roll back
# independently by changing IMAGE_PROVIDER_MODE=fal and/or
# SPEECH_PROVIDER_MODE=elevenlabs and redeploying.
IMAGE_PROVIDER_MODE=freellmapi
SPEECH_PROVIDER_MODE=freellmapi
FREELLMAPI_IMAGE_MODEL=flux
FREELLMAPI_SPEECH_MODEL=openai-audio
FREELLMAPI_SPEECH_VOICE=onyx
FREELLMAPI_SPEECH_FORMAT=mp3
FREELLMAPI_MEDIA_TIMEOUT_MS=120000

# Paid reasoning fallback/direct rollback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Retained for SPEECH_PROVIDER_MODE=elevenlabs rollback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Retained for IMAGE_PROVIDER_MODE=fal rollback. Fal preserves the stronger
# FLUX.2 reference-conditioned character/scene continuity path.
FAL_KEY=

# Daily production.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_HOUR_UTC=19
SCHEDULE_MEASURE_HOURS=24

# Legacy stock credentials retained for old/manual workflows only.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
AMOS_ALLOW_PUBLISH=1

# --- renderer tuning ---------------------------------------------------
# COMPOSE_CONCURRENCY=3
# TZ=Europe/Berlin
