# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. You can skip this entirely and enter the keys in the UI instead —
# those are stored in the vidgen_data volume and survive restarts.
#
#   cp .env.example .env      # then edit
#   docker compose up --build
#   → http://localhost:4321

# Reasoning agents (story, script, visual plan). The only required one.
#   https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Voiceover. Without these, fake audio is generated instead.
#   Key:      https://elevenlabs.io -> profile menu -> API key
#   Voice id: Voices -> pick a voice -> copy its ID (not its name)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Scene images — free stock photography, so images cost nothing.
# At least ONE of Pexels or Unsplash is required. Pixabay is only ever a third
# fallback and cannot enable image search on its own. Without any of them,
# placeholder images are used and the video renders but is unusable.
#   Pexels:   https://www.pexels.com/api/                (free, no card)
#   Unsplash: https://unsplash.com/oauth/applications    (the Access Key)
#   Pixabay:  https://pixabay.com/api/docs/              (optional)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Publishing. OAuth2 credentials for YouTube Data API v3.
# Scope: https://www.googleapis.com/auth/youtube.upload
# Custom thumbnails additionally require a phone-verified channel.
#
# First-time setup:
#   1. Fill in CLIENT_ID and CLIENT_SECRET below
#   2. Run: node --import tsx scripts/youtube-token.ts --auth
#   3. It gives you a refresh token and writes it here automatically
#
# Ongoing (refresh the access token before a publish run):
#   node --import tsx scripts/youtube-token.ts
#
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# A token alone never uploads. Set to 1 to allow real publishing; uploads are
# always PRIVATE regardless.
AMOS_ALLOW_PUBLISH=1

# --- renderer tuning (rarely needed) ---------------------------------------
# COMPOSE_CONCURRENCY=3     # parallel scene builds; higher risks OOM at 6GB
# KENBURNS_UPSCALE=3500     # pre-zoompan upscale height
# TZ=Europe/Berlin
