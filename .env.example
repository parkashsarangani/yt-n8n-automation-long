# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. The production deployment supplies these from GitHub secrets/vars.

# Shared FreeLLMAPI instance (owned by the Shorts stack on the same server).
# RFC 0010 pins text to a concrete Google model; do not use auto/auto:* here.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODEL=gemini-2.5-flash
FREELLMAPI_VISION_MODEL=auto:smart

# FreeLLMAPI may still provide narration speech. It is NOT an image provider.
SPEECH_PROVIDER_MODE=freellmapi
FREELLMAPI_SPEECH_MODEL=auto
FREELLMAPI_SPEECH_VOICE=onyx
# Preference only: Google/Gemini TTS may legitimately return WAV.
FREELLMAPI_SPEECH_FORMAT=mp3
FREELLMAPI_MEDIA_TIMEOUT_MS=120000

# Paid reasoning fallback/direct rollback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Retained for SPEECH_PROVIDER_MODE=elevenlabs rollback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# RFC 0010 image generation: fal.ai only. FLUX.2 supports the stronger
# reference-conditioned continuity path required by recurring scenes/entities.
FAL_KEY=
FAL_MODEL=fal-ai/flux-2
# Optional; defaults to ${FAL_MODEL}/edit.
FAL_EDIT_MODEL=
# Optional cost-accounting override in USD per generated image.
FAL_PRICE_PER_IMAGE=

# Daily production.
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_HOUR_UTC=19
SCHEDULE_MEASURE_HOURS=24

# Legacy stock credentials retained for old/manual workflows only.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
AMOS_ALLOW_PUBLISH=1

# --- renderer tuning ---------------------------------------------------
# COMPOSE_CONCURRENCY=3
# TZ=Europe/Berlin
