# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. You can skip this entirely and enter the keys in the UI instead —
# those are stored in the amos_data volume and survive restarts.
#
#   cp .env.example .env      # then edit
#   docker compose up --build
#   → http://localhost:4321

# Reasoning agents (story, script, visual plan). The only required one.
#   https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Voiceover. Without these, fake audio is generated instead.
#   Key:      https://elevenlabs.io -> profile menu -> API key
#   Voice id: Voices -> pick a voice -> copy its ID (not its name)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Image generation. Without it, fake images are generated instead.
#   https://fal.ai/dashboard/keys        (format: id:secret)
FAL_KEY=

# Publishing. An OAuth2 ACCESS TOKEN (expires ~1h), not an API key.
# Scope: https://www.googleapis.com/auth/youtube.upload
# Custom thumbnails additionally require a phone-verified channel.
YOUTUBE_ACCESS_TOKEN=

# A token alone never uploads. Set to 1 to allow real publishing; uploads are
# always PRIVATE regardless.
AMOS_ALLOW_PUBLISH=

# --- renderer tuning (rarely needed) ---------------------------------------
# COMPOSE_CONCURRENCY=3     # parallel scene builds; higher risks OOM at 6GB
# KENBURNS_UPSCALE=3500     # pre-zoompan upscale height
# TZ=Europe/Berlin
