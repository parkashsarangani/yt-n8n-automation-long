# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. The production deployment supplies these from GitHub secrets/vars.

# Shared FreeLLMAPI instance (owned by the Shorts stack on the same server).
# All text/reasoning uses an ordered chain of concrete FREE models with no paid
# fallback. Leave FREELLMAPI_TEXT_MODELS empty for the engine default chain, or
# set a comma list of concrete ids (no auto / auto:*).
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODELS=

# Narration remains on the established ElevenLabs path.
SPEECH_PROVIDER_MODE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=gZiz6WFdAxF6MKJ0s5s6
ELEVENLABS_SPEED=1.0
ELEVENLABS_STABILITY=0.45
ELEVENLABS_STYLE=0

# Only for pre-TTS moderation and the manual LLM_ROUTER_MODE=direct rollback.
# Normal automated runs never call it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Thumbnail artwork. The audio-first graph generates exactly one image per
# episode — the thumbnail — so this is the only image credential it needs.
FAL_KEY=
FAL_MODEL=fal-ai/flux-2
# Optional cost-accounting override in USD per generated image.
FAL_PRICE_PER_IMAGE=

# Prepare at 03:00 Berlin; Drive delivery is released at 05:00 Berlin daily.
# Preparation resolves from local time on every tick. Set
# SCHEDULE_PRODUCE_HOUR_UTC to pin a literal UTC hour instead (overrides both).
SCHEDULE_PRODUCE_HOURS=24
SCHEDULE_PRODUCE_TIMEZONE=Europe/Berlin
SCHEDULE_PRODUCE_LOCAL_HOUR=3
SCHEDULE_PRODUCE_HOUR_UTC=
SCHEDULE_MEASURE_HOURS=24

# Publishing / analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
AMOS_ALLOW_PUBLISH=1

# Human editor handoff. Every run now waits at editor_review for a light
# touch-up cut before publishing -- without these, that wait never ends.
# Needs the full https://www.googleapis.com/auth/drive scope, not drive.file,
# so the editor's uploaded final.mp4 is visible to the app.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
SCHEDULE_EDITOR_WATCH_MINUTES=20

# --- renderer tuning ---------------------------------------------------
# Stock suggestions use the configured sources. Missing keys/matches use graphics.
# Set graphics to disable stock, or hybrid for ./media-library/manifest.json.
FOOTAGE_MODE=stock
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# COMPOSE_CONCURRENCY=3
# TZ=Europe/Berlin
