# Optional. Copy to `.env` beside docker-compose.yml to seed credentials at
# startup. You can also enter supported keys in the local UI.
#
#   cp .env.example .env
#   docker compose up --build
#   → http://localhost:4321

# Reasoning agents: story, dialogue, cartoon direction, SEO and thumbnail plan.
ANTHROPIC_API_KEY=

# Character voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Generated CARTOON THUMBNAIL artwork. The video scenes themselves use the
# deterministic SVG puppet/background library, so this is not spent per scene.
FAL_KEY=

# Stable recurring cast used by unattended/daily production.
# Mount or place this JSON file where the engine container can read it.
# The payload must satisfy cast_roster@1.1.0.
CARTOON_CAST_PATH=/app/config/cast_roster.json

# Daily production. Leave unset/blank to keep production manual. 24 = daily.
SCHEDULE_PRODUCE_HOURS=24

# Read-only analytics refresh. Set 0 to disable.
SCHEDULE_MEASURE_HOURS=24

# Legacy stock credentials are kept only for old/manual deployments. The
# default and scheduled production graphs no longer use stock photography.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Publishing. OAuth2 credentials for YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# A token alone never uploads. Set to 1 to allow real publishing; uploads remain
# PRIVATE so the final operator review happens in YouTube Studio.
AMOS_ALLOW_PUBLISH=1

# --- renderer tuning --------------------------------------------------------
# COMPOSE_CONCURRENCY=3
# TZ=Europe/Berlin
