{
  "version": 2,
  "policy": {
    "runtimeNetworkAccess": false,
    "renderContract": "All referenced assets must resolve to files under long-compose/remotion/public/assets or to internal Remotion components. External APIs are allowed only during offline asset acquisition, never during render.",
    "fallback": "If a registry asset is missing, renderer falls back to the existing JSX/generated background path.",
    "qualityTarget": "Prefer complete scene plates for story locations; layer characters, captions, and small props on top.",
    "status": "PR93 establishes the local registry contract and starter placeholder assets; PR94 expands scene-plate coverage to 16 curated locations. None of the iconify/open-peeps/lottie examples are real imported third-party assets yet; those must be acquired offline and vendored later."
  },
  "sources": [
    {
      "library": "scene-pack",
      "purpose": "Complete local background scene plates and set pieces.",
      "runtime": "local-svg",
      "license": "CC0-1.0 or internally-authored equivalent"
    },
    {
      "library": "iconify",
      "purpose": "Small object and prop icons, vendored as SVG files.",
      "runtime": "local-svg",
      "license": "Per-icon-set; allowlist only Apache-2.0, MIT, CC0, or similarly permissive sets."
    },
    {
      "library": "open-peeps",
      "purpose": "Character parts and expression components, vendored as SVG files.",
      "runtime": "local-svg",
      "license": "CC0-1.0"
    },
    {
      "library": "lottie",
      "purpose": "Reusable motion/effect clips, vendored as JSON.",
      "runtime": "local-lottie",
      "license": "Allowlisted local files only."
    },
    {
      "library": "remotion-bits",
      "purpose": "Internal Remotion motion primitives and effects.",
      "runtime": "remotion-component",
      "license": "MIT"
    }
  ],
  "assets": [
    { "key": "scene:office:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/office/default.svg", "license": "CC0-1.0", "status": "starter-local" },
    { "key": "scene:kitchen:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/kitchen/default.svg", "license": "CC0-1.0", "status": "starter-local" },
