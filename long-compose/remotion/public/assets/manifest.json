    { "key": "scene:classroom:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/classroom/default.svg", "license": "CC0-1.0", "status": "starter-local" },
    { "key": "scene:cafe:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/cafe/default.svg", "license": "CC0-1.0", "status": "starter-local" },
    { "key": "scene:street:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/street/default.svg", "license": "CC0-1.0", "status": "starter-local" },
    { "key": "scene:park:default", "role": "scenePlate", "library": "scene-pack", "path": "assets/scene-plates/park/default.svg", "license": "CC0-1.0", "status": "starter-local" },
