{
  "name": "long-compose",
  "version": "2.0.0",
  "description": "Hybrid Remotion + FFmpeg composition service for studio-grade YouTube long-form \u00e2\u20ac\u201d Remotion for motion graphics and captions, FFmpeg for stock scenes, audio mixing, and final encoding.",
  "main": "compose.js",
  "scripts": {
    "start": "node compose.js",
    "test": "node --test tests/*.test.js",
    "test:contracts": "node scripts/run-tests.mjs contracts",
    "test:render": "node scripts/run-tests.mjs render",
    "test:render:motion": "node scripts/run-tests.mjs motion-design-render.test.js",
    "test:render:output": "node scripts/run-tests.mjs output-quality.test.js",
    "remotion:studio": "cd remotion && npx remotion studio"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "express": "^4.19.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
